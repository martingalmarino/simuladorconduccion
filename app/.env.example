# Publicación / SEO
# Dejá INDEXABLE_PRODUCTION=false en preview y desarrollo.
# Solo poné true cuando tengas dominio HTTPS definitivo y revisión de lanzamiento.

INDEXABLE_PRODUCTION=false

# URL canónica absoluta del sitio en producción, con https:// y sin path.
# Ejemplo: https://www.ejemplo.com
# No inventes un dominio. Si está vacío, no se emiten canonicales ni sitemap indexable.
# SITE_URL=

# Checklist de producción (manual):
# 1. Marca y dominio reales confirmados
# 2. SITE_URL=https://tu-dominio
# 3. INDEXABLE_PRODUCTION=true
# 4. Revisión editorial humana del banco
# 5. Canal de contacto/reporte configurado
# 6. Verificar Search Console y enviar /sitemap.xml
