---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const gradId = `pv-mark-${Math.random().toString(36).slice(2, 9)}`;
---

<span class:list={['brand-logo', compact && 'brand-logo--compact']}>
  <svg
    class="brand-logo__mark"
    viewBox="0 0 40 40"
    width="40"
    height="40"
    role="img"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id={gradId} x1="8" y1="4" x2="34" y2="36" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#1D4ED8" />
        <stop offset="100%" stop-color="#0F3CC9" />
      </linearGradient>
    </defs>
    <rect width="40" height="40" rx="11" fill={`url(#${gradId})`} />
    <!-- Road curve -->
    <path
      d="M8 28c6-10 10-14 18-16"
      fill="none"
      stroke="#93C5FD"
      stroke-width="3.2"
      stroke-linecap="round"
    />
    <path
      d="M8 28c6-10 10-14 18-16"
      fill="none"
      stroke="#FFFFFF"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-dasharray="2.2 3.4"
      opacity="0.95"
    />
    <!-- Check / practice mark -->
    <path
      d="M22.5 24.5l3.2 3.2 6.8-8"
      fill="none"
      stroke="#FFFFFF"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <span class="brand-logo__text">
    <span class="brand-logo__name">Práctica Vial</span>
    {
      !compact && (
        <span class="brand-logo__domain">practicavial.com.ar</span>
      )
    }
  </span>
</span>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: inherit;
    text-decoration: none;
  }

  .brand-logo__mark {
    flex: 0 0 auto;
    display: block;
    border-radius: 11px;
    box-shadow: 0 4px 12px rgba(29, 78, 216, 0.22);
  }

  .brand-logo__text {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    line-height: 1.1;
  }

  .brand-logo__name {
    font-weight: 800;
    font-size: 1.08rem;
    letter-spacing: -0.04em;
    color: var(--td-ink);
  }

  .brand-logo__domain {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--td-muted);
  }

  .brand-logo--compact .brand-logo__name {
    font-size: 1.02rem;
  }

  @media (max-width: 560px) {
    .brand-logo__domain {
      display: none;
    }

    .brand-logo__mark {
      width: 34px;
      height: 34px;
    }
  }
</style>
