---
interface Card {
  title: string;
  icon: 'user' | 'list' | 'calendar' | 'car' | 'book' | 'pin';
  items: string[];
  note?: string;
}

interface Props {
  cards: Card[];
}

const { cards } = Astro.props;
---

<div class="fact-grid">
  {
    cards.map((card) => (
      <article class="fact-card">
        <div class="fact-card__head">
          <span class="fact-card__icon" aria-hidden="true">
            {card.icon === 'user' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="3.2" />
                <path d="M5.5 19.2c1.4-2.6 3.7-3.9 6.5-3.9s5.1 1.3 6.5 3.9" />
              </svg>
            )}
            {card.icon === 'list' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 7h10M9 12h10M9 17h10" />
                <path d="M5 7h.01M5 12h.01M5 17h.01" />
              </svg>
            )}
            {card.icon === 'calendar' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="5" width="16" height="15" rx="2" />
                <path d="M8 3.5v3M16 3.5v3M4 10h16" />
              </svg>
            )}
            {card.icon === 'car' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 15h16l-1.2-4.2a2 2 0 0 0-1.9-1.4H7.1a2 2 0 0 0-1.9 1.4L4 15z" />
                <path d="M6.5 15v2.2M17.5 15v2.2" />
                <circle cx="7.5" cy="15" r="1.1" fill="currentColor" stroke="none" />
                <circle cx="16.5" cy="15" r="1.1" fill="currentColor" stroke="none" />
              </svg>
            )}
            {card.icon === 'book' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
              </svg>
            )}
            {card.icon === 'pin' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10z" />
                <circle cx="12" cy="11" r="2" />
              </svg>
            )}
          </span>
          <h3>{card.title}</h3>
        </div>
        <ul>
          {
            card.items.map((item) => (
              <li>
                <span class="fact-card__mark" aria-hidden="true">
                  <svg viewBox="0 0 20 20" width="18" height="18">
                    <circle cx="10" cy="10" r="9" fill="currentColor" />
                    <path d="M6 10.2l2.4 2.4L14 7.4" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        {card.note && <p class="fact-card__note">{card.note}</p>}
      </article>
    ))
  }
</div>
