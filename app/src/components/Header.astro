---
import { getSiteConfig } from '../lib/content';

const config = getSiteConfig();
const path = Astro.url.pathname;
const isHome = path === '/';
---

<a class="skip-link" href="#contenido">Saltar al contenido</a>
<header class:list={['site-header', isHome && 'site-header--home']}>
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label={`${config.siteName} · practicavial.com.ar`}>
      {
        isHome ? (
          <img
            class="home-logo"
            src="/brand/practicavial-logo.svg"
            alt="Practicavial"
            width="190"
            height="44"
          />
        ) : (
          <img
            class="internal-logo"
            src="/brand/practicavial-logo.svg"
            alt="Practicavial"
            width="190"
            height="44"
          />
        )
      }
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
      aria-label="Abrir menú"
    >
      <span class="nav-toggle__icon" aria-hidden="true"></span>
    </button>
    <nav id="menu-principal" class="nav" aria-label="Principal">
      <a
        href="/test-de-conducir/"
        aria-current={path.startsWith('/test-de-conducir') ? 'page' : undefined}
      >
        Tests
      </a>
      <a href="/#como-practicar">Cómo practicar</a>
      <a
        href="/fuentes-y-metodologia/"
        aria-current={path.startsWith('/fuentes-y-metodologia') ? 'page' : undefined}
      >
        Fuentes
      </a>
      <a
        class:list={['btn', 'btn--primary', 'nav__cta', isHome && 'home-nav-cta']}
        href="/#empezar"
      >
        Empezar test
      </a>
    </nav>
  </div>
</header>
<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = header?.querySelector<HTMLElement>('#menu-principal');

  if (header && toggle && nav) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    nav.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !target.closest('a')) return;
      window.setTimeout(() => setOpen(false), 0);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Node) || header.contains(target)) return;
      if (header.classList.contains('is-open')) setOpen(false);
    });
  }
</script>
