---
interface Props {
  name: 'practice' | 'route';
}

const { name } = Astro.props;
---

{
  name === 'practice' ? (
    <svg
      viewBox="0 0 800 480"
      role="img"
      aria-label="Ilustración de una persona practicando el teórico junto a un auto"
      preserveAspectRatio="xMidYMid meet"
    >
      <defs>
        <linearGradient id="p-sky" x1="0" y1="0" x2="0.2" y2="1">
          <stop offset="0%" stop-color="#DBEAFE" />
          <stop offset="55%" stop-color="#EFF6FF" />
          <stop offset="100%" stop-color="#F8FAFC" />
        </linearGradient>
        <linearGradient id="p-ground" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#E2E8F0" />
          <stop offset="100%" stop-color="#CBD5E1" />
        </linearGradient>
        <linearGradient id="p-card" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#FFFFFF" />
          <stop offset="100%" stop-color="#F8FAFC" />
        </linearGradient>
      </defs>

      <rect width="800" height="480" fill="url(#p-sky)" />
      <circle cx="680" cy="70" r="52" fill="#F8FAFC" opacity="0.85" />
      <circle cx="730" cy="85" r="34" fill="#F8FAFC" opacity="0.65" />
      <circle cx="90" cy="60" r="26" fill="#F8FAFC" opacity="0.55" />

      <rect y="330" width="800" height="150" fill="url(#p-ground)" />
      <path d="M0 330h800" stroke="#94A3B8" stroke-width="2" opacity="0.4" />
      <path d="M0 360h800" stroke="#F8FAFC" stroke-width="3" stroke-dasharray="18 22" opacity="0.7" />

      <!-- Large quiz panel -->
      <g transform="translate(40 70)">
        <rect width="320" height="250" rx="28" fill="url(#p-card)" stroke="#BFDBFE" stroke-width="3" />
        <rect x="28" y="32" width="168" height="16" rx="8" fill="#2563EB" />
        <rect x="28" y="64" width="250" height="11" rx="5" fill="#CBD5E1" />
        <rect x="28" y="86" width="210" height="11" rx="5" fill="#E2E8F0" />

        <rect x="28" y="126" width="264" height="44" rx="12" fill="#EFF6FF" stroke="#93C5FD" stroke-width="2" />
        <circle cx="54" cy="148" r="10" fill="#2563EB" />
        <circle cx="54" cy="148" r="4" fill="#FFFFFF" />
        <rect x="74" y="142" width="180" height="12" rx="6" fill="#334155" />

        <rect x="28" y="182" width="264" height="44" rx="12" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="2" />
        <circle cx="54" cy="204" r="10" fill="#E2E8F0" stroke="#CBD5E1" stroke-width="2" />
        <rect x="74" y="198" width="150" height="12" rx="6" fill="#94A3B8" />
      </g>

      <!-- Person -->
      <g transform="translate(390 95)">
        <ellipse cx="86" cy="250" rx="54" ry="12" fill="#94A3B8" opacity="0.35" />
        <circle cx="86" cy="48" r="32" fill="#FDE68A" />
        <path d="M54 42c10-22 54-22 64 0" fill="#1E3A8A" />
        <path d="M42 98c10-32 78-32 88 0v90H42V98z" fill="#2563EB" />
        <path d="M42 120c-22 10-34 34-26 52l22-8" fill="#2563EB" />
        <path d="M130 120c22 10 34 34 26 52l-22-8" fill="#1D4ED8" />
        <rect x="58" y="188" width="24" height="78" rx="12" fill="#1E40AF" />
        <rect x="94" y="188" width="24" height="78" rx="12" fill="#1E40AF" />
        <rect x="52" y="258" width="34" height="14" rx="7" fill="#0F172A" />
        <rect x="90" y="258" width="34" height="14" rx="7" fill="#0F172A" />
      </g>

      <!-- Car -->
      <g transform="translate(520 235)">
        <ellipse cx="120" cy="118" rx="110" ry="14" fill="#64748B" opacity="0.25" />
        <path d="M24 78h210l-16-46a24 24 0 0 0-22-15H82a24 24 0 0 0-23 16L42 78z" fill="#2563EB" />
        <path d="M90 32h78l18 30H74l16-30z" fill="#93C5FD" />
        <rect x="12" y="78" width="232" height="38" rx="14" fill="#1D4ED8" />
        <circle cx="70" cy="118" r="22" fill="#0F172A" />
        <circle cx="70" cy="118" r="9" fill="#94A3B8" />
        <circle cx="188" cy="118" r="22" fill="#0F172A" />
        <circle cx="188" cy="118" r="9" fill="#94A3B8" />
        <rect x="210" y="88" width="16" height="10" rx="3" fill="#FDE68A" />
        <rect x="28" y="88" width="12" height="8" rx="2" fill="#F8FAFC" opacity="0.5" />
      </g>

      <!-- Plant -->
      <g transform="translate(720 285)">
        <rect x="16" y="48" width="28" height="34" rx="8" fill="#F1F5F9" stroke="#CBD5E1" />
        <path d="M30 48c-16-34 18-48 18-14 14-26 34-8 10 14" fill="#34D399" />
        <path d="M30 48c8-26 34-18 20 6" fill="#10B981" opacity="0.85" />
      </g>
    </svg>
  ) : (
    <svg
      viewBox="0 0 800 480"
      role="img"
      aria-label="Ilustración de un recorrido entre CABA y Córdoba Capital"
      preserveAspectRatio="xMidYMid meet"
    >
      <defs>
        <linearGradient id="r-sky" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#DBEAFE" />
          <stop offset="50%" stop-color="#EFF6FF" />
          <stop offset="100%" stop-color="#F8FAFC" />
        </linearGradient>
        <linearGradient id="r-hill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#BFDBFE" />
          <stop offset="100%" stop-color="#93C5FD" />
        </linearGradient>
      </defs>

      <rect width="800" height="480" fill="url(#r-sky)" />
      <path d="M0 250 C150 180 240 310 400 230 S620 160 800 220 V480 H0 Z" fill="url(#r-hill)" opacity="0.5" />
      <path d="M0 320 C170 270 280 360 430 310 S650 250 800 300 V480 H0 Z" fill="#E2E8F0" />

      <!-- Road full width -->
      <path
        d="M-20 360 C180 290 280 400 430 330 S650 270 820 310"
        fill="none"
        stroke="#475569"
        stroke-width="36"
        stroke-linecap="round"
      />
      <path
        d="M-20 360 C180 290 280 400 430 330 S650 270 820 310"
        fill="none"
        stroke="#F8FAFC"
        stroke-width="5"
        stroke-linecap="round"
        stroke-dasharray="3 20"
      />

      <!-- Badge CABA -->
      <g transform="translate(48 70)">
        <rect width="200" height="78" rx="18" fill="#FFFFFF" stroke="#BFDBFE" stroke-width="2.5" />
        <circle cx="42" cy="39" r="18" fill="#EFF6FF" />
        <path d="M42 26c9 0 15 6 15 14 0 12-15 22-15 22s-15-10-15-22c0-8 6-14 15-14z" fill="#2563EB" />
        <circle cx="42" cy="40" r="4.5" fill="#FFFFFF" />
        <text x="72" y="34" font-family="Plus Jakarta Sans, system-ui, sans-serif" font-size="18" font-weight="800" fill="#0F172A">CABA</text>
        <text x="72" y="56" font-family="Plus Jakarta Sans, system-ui, sans-serif" font-size="13" font-weight="600" fill="#64748B">Buenos Aires</text>
      </g>

      <!-- Badge Córdoba -->
      <g transform="translate(530 55)">
        <rect width="220" height="78" rx="18" fill="#FFFFFF" stroke="#A7F3D0" stroke-width="2.5" />
        <circle cx="42" cy="39" r="18" fill="#ECFDF5" />
        <path d="M42 26c9 0 15 6 15 14 0 12-15 22-15 22s-15-10-15-22c0-8 6-14 15-14z" fill="#059669" />
        <circle cx="42" cy="40" r="4.5" fill="#FFFFFF" />
        <text x="72" y="34" font-family="Plus Jakarta Sans, system-ui, sans-serif" font-size="18" font-weight="800" fill="#0F172A">Córdoba</text>
        <text x="72" y="56" font-family="Plus Jakarta Sans, system-ui, sans-serif" font-size="13" font-weight="600" fill="#64748B">Capital</text>
      </g>

      <!-- Car -->
      <g transform="translate(300 275)">
        <path d="M22 60h140l-12-32a16 16 0 0 0-15-10H64a16 16 0 0 0-15 11L36 60z" fill="#2563EB" />
        <path d="M68 28h48l12 20H58l10-20z" fill="#BFDBFE" />
        <rect x="14" y="60" width="156" height="26" rx="10" fill="#1D4ED8" />
        <circle cx="52" cy="88" r="14" fill="#0F172A" />
        <circle cx="52" cy="88" r="6" fill="#94A3B8" />
        <circle cx="132" cy="88" r="14" fill="#0F172A" />
        <circle cx="132" cy="88" r="6" fill="#94A3B8" />
        <rect x="148" y="68" width="14" height="8" rx="2" fill="#FDE68A" />
      </g>

      <!-- Cityscape left -->
      <g transform="translate(40 285)">
        <rect x="0" y="50" width="42" height="80" rx="6" fill="#FFFFFF" stroke="#CBD5E1" />
        <rect x="50" y="20" width="48" height="110" rx="6" fill="#FFFFFF" stroke="#CBD5E1" />
        <rect x="106" y="58" width="36" height="72" rx="6" fill="#FFFFFF" stroke="#CBD5E1" />
        <rect x="10" y="64" width="10" height="10" rx="2" fill="#93C5FD" />
        <rect x="24" y="64" width="10" height="10" rx="2" fill="#93C5FD" />
        <rect x="62" y="40" width="10" height="10" rx="2" fill="#93C5FD" />
        <rect x="78" y="40" width="10" height="10" rx="2" fill="#93C5FD" />
      </g>

      <!-- Cityscape right -->
      <g transform="translate(620 270)">
        <rect x="0" y="40" width="40" height="90" rx="6" fill="#FFFFFF" stroke="#CBD5E1" />
        <rect x="48" y="10" width="52" height="120" rx="6" fill="#FFFFFF" stroke="#CBD5E1" />
        <rect x="108" y="48" width="34" height="82" rx="6" fill="#FFFFFF" stroke="#CBD5E1" />
        <rect x="60" y="28" width="10" height="10" rx="2" fill="#6EE7B7" />
        <rect x="78" y="28" width="10" height="10" rx="2" fill="#6EE7B7" />
      </g>
    </svg>
  )
}
