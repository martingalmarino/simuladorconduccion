---
import type { JurisdictionConfig, QuestionBank } from '../types/content';
import { topicLabel } from '../lib/topics';

interface Props {
  jurisdiction: JurisdictionConfig;
  bank: QuestionBank;
}

const { jurisdiction, bank } = Astro.props;
const topics = [...new Set(bank.questions.map((q) => q.topic))];
---

<article class:list={['card', 'jurisdiction-card', `jurisdiction-card--${jurisdiction.slug}`]}>
  <p class="kicker">Autos · B1</p>
  <h2>{jurisdiction.label}</h2>
  <p class="muted">{jurisdiction.geographicScope}</p>
  <p class="jurisdiction-card__count">
    <strong>{bank.questions.length} preguntas</strong> para practicar.
  </p>
  <p class="jurisdiction-card__coverage">{bank.coverage}</p>
  <div class="topic-chips" aria-label="Temas incluidos">
    {topics.slice(0, 6).map((topic) => <span class="chip">{topicLabel(topic)}</span>)}
  </div>
  <div class="btn-row">
    <a class="btn btn--primary" href={`/practicar/${jurisdiction.slug}/`}>Empezar a practicar</a>
    <a class="btn btn--secondary" href={`/test-de-conducir/${jurisdiction.slug}/`}>Estudiar</a>
  </div>
</article>
