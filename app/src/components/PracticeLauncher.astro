---
import type { JurisdictionConfig } from '../types/content';

interface Props {
  jurisdictions: JurisdictionConfig[];
  questionCount: number;
  motoQuestionCount: number;
  notice: string;
  variant?: 'default' | 'home';
}

const {
  jurisdictions,
  questionCount,
  motoQuestionCount,
  notice,
  variant = 'default',
} = Astro.props;
const isHome = variant === 'home';
const defaultSlug = jurisdictions[0]?.slug ?? 'caba';
---

<form
  class:list={[isHome ? 'home-launch' : 'card launch-card']}
  id={isHome ? undefined : 'empezar'}
  method="get"
  action={`/practicar/${defaultSlug}/`}
>
  {
    isHome && <h2 class="home-launch__title">Empezá en 2 pasos</h2>
  }
  <div class="launch-field">
    <label for="launch-category" id="launch-vehicle-label">
      {isHome ? '1. Categoría' : 'Categoría'}
    </label>
    <div class="launch-select">
      <svg class="launch-select__icon" data-icon="auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M3 13l2-5a2 2 0 0 1 2-1h10a2 2 0 0 1 2 1l2 5"></path>
        <path d="M5 13h14v4a1 1 0 0 1-1 1h-1a2 2 0 0 1-4 0H9a2 2 0 0 1-4 0H4a1 1 0 0 1-1-1v-4z"></path>
      </svg>
      <svg class="launch-select__icon" data-icon="moto" hidden viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="6.5" cy="16.5" r="2.5"></circle>
        <circle cx="17.5" cy="16.5" r="2.5"></circle>
        <path d="M6.5 16.5h3l2.2-6h4.2l1.6 3.2H17.5"></path>
        <path d="M9.2 10.5 8 7.5h3"></path>
      </svg>
      <select id="launch-category">
        <option value="b1" selected>Autos · Clase B1</option>
        <option value="a">Motos · Categoría A</option>
      </select>
    </div>
  </div>

  <div class="launch-field" id="launch-place-field">
    <label for="launch-place">{isHome ? '2. ¿Dónde vas a rendir?' : '¿Dónde vas a rendir?'}</label>
    <div class="launch-select">
      <svg class="launch-select__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M12 21s7-4.5 7-11a7 7 0 1 0-14 0c0 6.5 7 11 7 11z"></path>
        <circle cx="12" cy="10" r="2.5"></circle>
      </svg>
      <select id="launch-place" name="place">
        {
          jurisdictions.map((j) => (
            <option value={j.slug} selected={j.slug === defaultSlug}>
              {j.label}
            </option>
          ))
        }
      </select>
    </div>
    <p class="launch-scope" id="launch-scope" aria-live="polite">
      {jurisdictions.find((j) => j.slug === defaultSlug)?.geographicScope}
    </p>
  </div>

  <button
    class:list={[
      isHome ? 'home-btn home-btn--primary home-btn--block' : 'btn btn--primary btn--block btn--lg',
    ]}
    type="submit"
  >
    {isHome ? 'Empezar test →' : 'Empezar a practicar'}
  </button>
  <p class="launch-hint" id="launch-hint">
    {questionCount} preguntas por ciudad · Sin registro · {notice}
  </p>
</form>

<style>
  .launch-label {
    display: block;
    font-size: 0.84rem;
    font-weight: 700;
    margin-bottom: 0.45rem;
    color: var(--td-ink);
  }
  .launch-select__value {
    font-weight: 600;
    color: var(--td-ink);
  }
  .launch-scope {
    margin: 0.45rem 0 0;
    font-size: 0.82rem;
    color: var(--td-muted);
    line-height: 1.4;
  }
  .launch-select select {
    text-overflow: ellipsis;
  }
</style>

<script
  define:vars={{
    scopes: Object.fromEntries(jurisdictions.map((j) => [j.slug, j.geographicScope])),
    questionCount,
    motoQuestionCount,
    notice,
  }}
>
  const root = document.getElementById('empezar');
  const form = root instanceof HTMLFormElement ? root : root?.querySelector('form') ?? null;
  const place = document.getElementById('launch-place');
  const placeField = document.getElementById('launch-place-field');
  const category = document.getElementById('launch-category');
  const scope = document.getElementById('launch-scope');
  const hint = document.getElementById('launch-hint');
  const autoIcon = document.querySelector('[data-icon="auto"]');
  const motoIcon = document.querySelector('[data-icon="moto"]');
  if (
    form instanceof HTMLFormElement &&
    place instanceof HTMLSelectElement &&
    category instanceof HTMLSelectElement
  ) {
    const sync = () => {
      const motos = category.value === 'a';
      form.action = motos ? '/test-de-conducir/categoria-a/' : `/practicar/${place.value}/`;
      if (placeField) placeField.hidden = motos;
      place.disabled = motos;
      if (scope && !motos) scope.textContent = scopes[place.value] ?? '';
      if (autoIcon) autoIcon.hidden = motos;
      if (motoIcon) motoIcon.hidden = !motos;
      if (hint) {
        hint.textContent = motos
          ? `${motoQuestionCount} preguntas · Sin registro · ${notice}`
          : `${questionCount} preguntas por ciudad · Sin registro · ${notice}`;
      }
    };
    place.addEventListener('change', sync);
    category.addEventListener('change', sync);
    form.addEventListener('submit', (event) => {
      if (category.value !== 'a') return;
      event.preventDefault();
      window.location.assign('/test-de-conducir/categoria-a/');
    });
    sync();
  }
</script>
