---
import { absoluteUrl, getSiteRuntime } from '../lib/site';

interface Props {
  title: string;
  description: string;
  pathname: string;
  noindex?: boolean;
  /** Si es true, el title no suma el nombre del sitio. Por defecto se mantiene el sufijo. */
  exactTitle?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, pathname, noindex = false, exactTitle = false, jsonLd } = Astro.props;
const runtime = getSiteRuntime();
const shouldNoindex = noindex || !runtime.indexable;
const robots = shouldNoindex ? 'noindex,follow' : 'index,follow';
const canonical = runtime.indexable ? absoluteUrl(pathname) : null;
const fullTitle =
  exactTitle || title.includes(runtime.siteName) ? title : `${title} | ${runtime.siteName}`;
const jsonLdPayload =
  jsonLd && !Array.isArray(jsonLd) && '@graph' in jsonLd
    ? jsonLd
    : jsonLd
      ? Array.isArray(jsonLd)
        ? jsonLd
        : [jsonLd]
      : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="google-site-verification" content="zpSGytwKa2TJX7OwoZ0ImE8_u55OhlIgplkaBb3hBSM" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="es_AR" />
{canonical && <meta property="og:url" content={canonical} />}
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
{
  jsonLdPayload && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLdPayload)}
    />
  )
}
