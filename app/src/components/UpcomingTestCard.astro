---
import type { UpcomingTest } from '../types/content';

interface Props {
  test: UpcomingTest;
}

const { test } = Astro.props;
const href = `/test-de-conducir/${test.slug}/`;
---

<article class="card upcoming-card">
  <div class="upcoming-card__top">
    <p class="kicker">Test teórico</p>
    <span class="badge badge--soon">Próximamente</span>
  </div>
  <h2>
    <a href={href}>{test.title}</a>
  </h2>
  <p class="upcoming-card__subtitle">{test.subtitle}</p>
  <p class="muted">
    Categoría {test.licenseClass}. Todavía no hay preguntas publicadas para practicar.
  </p>
  <a class="btn btn--secondary" href={href}>Más información</a>
</article>
