---
import Layout from '../../components/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SourceMethodology from '../../components/SourceMethodology.astro';
import { absoluteUrl, getSiteRuntime } from '../../lib/site';

const runtime = getSiteRuntime();
const pageUrl = absoluteUrl('/fuentes-y-metodologia/');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Fuentes y metodología',
    inLanguage: runtime.locale,
    description:
      'Procedencia de las preguntas, fechas de consulta de fuentes, alcance introductorio y correcciones.',
    ...(pageUrl ? { url: pageUrl } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Inicio',
        ...(absoluteUrl('/') ? { item: absoluteUrl('/') } : {}),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Fuentes y metodología',
        ...(pageUrl ? { item: pageUrl } : {}),
      },
    ],
  },
];
---

<Layout
  title="Fuentes y metodología del test de conducir"
  description="Cómo se redactaron las preguntas, qué jurisdicciones cubre la ampliación intermedia, fechas de consulta de fuentes y cómo reportar errores."
  pathname="/fuentes-y-metodologia/"
  jsonLd={jsonLd}
>
  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Fuentes y metodología' },
    ]}
  />

  <h1>Fuentes y metodología</h1>
  <p class="lede">
    Transparencia sobre el origen del material, sus límites y el estado de revisión. Sin sellos de
    aprobación inventados.
  </p>

  <SourceMethodology />
</Layout>
