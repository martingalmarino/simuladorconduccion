---
import Layout from '../../components/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SourceMethodology from '../../components/SourceMethodology.astro';
import { absoluteUrl, getSiteRuntime } from '../../lib/site';

const runtime = getSiteRuntime();
const pageUrl = absoluteUrl('/fuentes-y-metodologia/');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Fuentes y metodología',
    inLanguage: runtime.locale,
    description:
      'De dónde salen las preguntas, fechas de consulta de fuentes, alcance del material y cómo reportar errores.',
    ...(pageUrl ? { url: pageUrl } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Inicio',
        ...(absoluteUrl('/') ? { item: absoluteUrl('/') } : {}),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Fuentes y metodología',
        ...(pageUrl ? { item: pageUrl } : {}),
      },
    ],
  },
];
---

<Layout
  title="Fuentes y metodología del test de conducir"
  description="De dónde salen las preguntas del teórico, qué ciudades cubre el sitio, fechas de consulta de fuentes y cómo reportar errores."
  pathname="/fuentes-y-metodologia/"
  jsonLd={jsonLd}
>
  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Fuentes y metodología' },
    ]}
  />

  <h1>Fuentes y metodología</h1>
  <p class="lede">
    De dónde sale el material, hasta dónde llega y con qué fuentes se contrastaron las respuestas.
  </p>

  <SourceMethodology />
</Layout>
