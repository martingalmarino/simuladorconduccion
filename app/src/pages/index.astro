---
import Layout from '../components/Layout.astro';
import PracticeLauncher from '../components/PracticeLauncher.astro';
import bancoCategoriaA from '../data/preguntas-categoria-a.json';
import { getBank, getSiteConfig, resolveQuestionSources } from '../lib/content';
import { absoluteUrl, getSiteRuntime } from '../lib/site';
import { topicLabel } from '../lib/topics';
import '../styles/home.css';

const config = getSiteConfig();
const runtime = getSiteRuntime();
const cards = config.jurisdictions.map((j) => ({
  jurisdiction: j,
  bank: getBank(j.bankId),
}));
const questionCount = cards[0]?.bank.questions.length ?? 20;
const motoQuestionCount = bancoCategoriaA.preguntas.length;
const motoTopics = [...new Set(bancoCategoriaA.preguntas.map((item) => item.tema))].slice(0, 2);

const argentinaBank = cards.find((card) => card.jurisdiction.slug === 'argentina')?.bank;
const example = argentinaBank?.questions[0];
const exampleSource = example ? resolveQuestionSources(example)[0] : undefined;

const placeStyle: Record<string, { stripe: string; tag: string; title: string; subtitle: string }> = {
  argentina: { stripe: 'azul', tag: 'Autos · B1', title: 'Argentina', subtitle: 'Marco nacional' },
  caba: { stripe: 'amarillo', tag: 'Autos · B1', title: 'CABA', subtitle: 'Ciudad de Buenos Aires' },
  'cordoba-capital': {
    stripe: 'naranja',
    tag: 'Autos · B1',
    title: 'Córdoba Capital',
    subtitle: 'Ciudad de Córdoba',
  },
};

const pageUrl = absoluteUrl('/');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: config.siteName,
    inLanguage: runtime.locale,
    ...(pageUrl ? { url: pageUrl } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Práctica Vial | Prepará tu examen teórico de conducir',
    inLanguage: runtime.locale,
    description:
      'Prepará el examen teórico de conducir con práctica general y tests por jurisdicción. Preguntas con respuestas explicadas, imágenes y fuentes para estudiar.',
    ...(pageUrl ? { url: pageUrl } : {}),
  },
];
---

<Layout
  title="Práctica Vial | Prepará tu examen teórico de conducir"
  description="Prepará el examen teórico de conducir con práctica general y tests por jurisdicción. Preguntas con respuestas explicadas, imágenes y fuentes para estudiar."
  pathname="/"
  jsonLd={jsonLd}
  fullBleed={true}
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Nunito:wght@700;800;900&display=swap"
    rel="stylesheet"
  />

  <div class="home">
    <section class="home-hero" id="empezar">
      <div class="home-wrap home-hero__grid">
        <div>
          <p class="home-kicker">Práctica Vial · Argentina</p>
          <h1>
            Prepará tu examen teórico de conducir
            <span class="home-h1-accent">con confianza</span>
          </h1>
          <p class="home-lede">
            Practicá con preguntas tipo test, entendé cada respuesta y descubrí qué necesitás
            repasar antes de rendir.
          </p>
          <ul class="home-checks">
            <li>
              <span class="home-check" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12.5 10 17l9-10"/></svg>
              </span>
              Sin registro
            </li>
            <li>
              <span class="home-check" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12.5 10 17l9-10"/></svg>
              </span>
              Gratis
            </li>
            <li>
              <span class="home-check" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12.5 10 17l9-10"/></svg>
              </span>
              Explicación y fuente en cada pregunta
            </li>
          </ul>
          <div class="home-signs" aria-hidden="true">
            <svg viewBox="0 0 80 80">
              <polygon points="28,6 52,6 74,28 74,52 52,74 28,74 6,52 6,28" fill="#c51f32" stroke="#fff" stroke-width="3"/>
              <text x="40" y="46" text-anchor="middle" font-family="Nunito, sans-serif" font-size="16" font-weight="800" fill="#fff">PARE</text>
            </svg>
            <svg viewBox="0 0 80 80">
              <rect x="28" y="8" width="24" height="64" rx="8" fill="#1b2333"/>
              <circle cx="40" cy="24" r="7" fill="#ef4444"/>
              <circle cx="40" cy="40" r="7" fill="#ffc83d"/>
              <circle cx="40" cy="56" r="7" fill="#1f9d6b"/>
            </svg>
            <svg viewBox="0 0 80 80">
              <polygon points="40,8 74,70 6,70" fill="#ffc83d" stroke="#1b2333" stroke-width="3" stroke-linejoin="round"/>
              <text x="40" y="58" text-anchor="middle" font-family="Nunito, sans-serif" font-size="28" font-weight="800" fill="#1b2333">!</text>
            </svg>
            <svg viewBox="0 0 80 80">
              <circle cx="40" cy="40" r="30" fill="#fff" stroke="#c51f32" stroke-width="6"/>
              <text x="40" y="48" text-anchor="middle" font-family="Nunito, sans-serif" font-size="26" font-weight="800" fill="#1b2333">60</text>
            </svg>
          </div>
        </div>

        <PracticeLauncher
          variant="home"
          jurisdictions={config.jurisdictions}
          questionCount={questionCount}
          motoQuestionCount={motoQuestionCount}
          notice="Práctica independiente"
        />
      </div>
      <div class="home-wrap">
        <div class="home-road" aria-hidden="true"></div>
      </div>
    </section>

    <section id="como-practicar" class="home-section home-section--white" aria-labelledby="como-titulo">
      <div class="home-wrap">
        <div class="home-head">
          <p class="home-kicker">Modalidades</p>
          <h2 id="como-titulo">Los pasos para practicar bien</h2>
          <p class="home-lede">
            Dos formas de practicar: con corrección al instante o al final. Sin reloj ni nota oficial
            de “aprobado”.
          </p>
        </div>
        <div class="home-steps">
          <article class="home-step">
            <div class="home-ico home-ico--azul" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-4.5 7-11a7 7 0 1 0-14 0c0 6.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            </div>
            <h3>Elegí jurisdicción</h3>
            <p>CABA o Córdoba Capital. Cada banco responde a su propia normativa local.</p>
            <a href="#jurisdicciones">Ir a las ciudades →</a>
          </article>
          <article class="home-step">
            <div class="home-ico home-ico--amarillo" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19h16M8 17V9m4 8V5m4 12v-4"/></svg>
            </div>
            <h3>Aprender con corrección inmediata</h3>
            <p>
              Elegís 10, 20 o {questionCount} preguntas. Después de responder ves la explicación y el
              enlace a la fuente.
            </p>
            <a href="#empezar">Empezar en modo Aprender →</a>
          </article>
          <article class="home-step">
            <div class="home-ico home-ico--naranja" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M8 12l2.5 2.5L16 9"/></svg>
            </div>
            <h3>Práctica con corrección al final</h3>
            <p>
              Podés hacer 20 o las {questionCount}. Al final ves aciertos, porcentaje, preguntas sin
              responder y temas a repasar. Es práctica, no un veredicto oficial.
            </p>
            <a href="#empezar">Configurar práctica →</a>
          </article>
          <article class="home-step">
            <div class="home-ico home-ico--verde" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5V6a2 2 0 0 1 2-2h9l5 5v10.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19.5z"/><path d="M14 4v5h5"/></svg>
            </div>
            <h3>Estudiá todas las preguntas</h3>
            <p>
              En la página de cada ciudad podés leer las {questionCount} preguntas con respuesta y
              fuente, sin necesidad de empezar una práctica.
            </p>
            <a href="/test-de-conducir/">Ver tests por ciudad →</a>
          </article>
        </div>
      </div>
    </section>

    <section id="jurisdicciones" class="home-section" aria-labelledby="jurisdicciones-titulo">
      <div class="home-wrap">
        <div class="home-head">
          <p class="home-kicker">Jurisdicciones</p>
          <h2 id="jurisdicciones-titulo">Elegí dónde vas a practicar</h2>
          <p class="home-lede">
            Hoy hay práctica para autos en dos ciudades y para motos (categoría A). Cada ciudad usa
            su propia normativa local.
          </p>
        </div>
        <div class="home-places">
          {
            cards.map(({ jurisdiction, bank }) => {
              const style = placeStyle[jurisdiction.slug] ?? {
                stripe: 'azul',
                tag: 'Autos · B1',
                title: jurisdiction.label,
                subtitle: jurisdiction.geographicScope,
              };
              const topics = [...new Set(bank.questions.map((q) => q.topic))].slice(0, 2);
              return (
                <article class="home-place">
                  <div class={`home-place__bar home-place__bar--${style.stripe}`}></div>
                  <div class="home-place__body">
                    <div class={`home-ico home-ico--${style.stripe}`} aria-hidden="true">
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-4.5 7-11a7 7 0 1 0-14 0c0 6.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                    </div>
                    <p class={`home-place__tag home-place__tag--${style.stripe}`}>{style.tag}</p>
                    <h3>{style.title}</h3>
                    <p class="home-place__sub">{style.subtitle}</p>
                    <p class="home-place__count">
                      <strong>{bank.questions.length}</strong>
                      preguntas
                    </p>
                    <div class="home-chips" aria-label="Temas incluidos">
                      {topics.map((topic) => <span class="home-chip">{topicLabel(topic)}</span>)}
                    </div>
                    <div class="home-place__actions">
                      <a class="home-btn home-btn--primary" href={`/practicar/${jurisdiction.slug}/`}>Practicar</a>
                      <a class="home-btn home-btn--secondary" href={`/test-de-conducir/${jurisdiction.slug}/`}>Estudiar</a>
                    </div>
                  </div>
                </article>
              );
            })
          }
          <article class="home-place">
            <div class="home-place__bar home-place__bar--verde"></div>
            <div class="home-place__body">
              <div class="home-ico home-ico--verde" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="6.5" cy="16.5" r="2.5"/><circle cx="17.5" cy="16.5" r="2.5"/><path d="M6.5 16.5h3l2.2-6h4.2l1.6 3.2H17.5"/><path d="M9.2 10.5 8 7.5h3"/></svg>
              </div>
              <p class="home-place__tag home-place__tag--verde">Motos</p>
              <h3>Categoría A</h3>
              <p class="home-place__sub">Motos, ciclomotores y cuatriciclos.</p>
              <p class="home-place__count">
                <strong>{motoQuestionCount}</strong>
                preguntas
              </p>
              <div class="home-chips" aria-label="Temas incluidos">
                {motoTopics.map((topic) => <span class="home-chip">{topic}</span>)}
              </div>
              <div class="home-place__actions">
                <a class="home-btn home-btn--primary" href="/test-de-conducir/categoria-a/#test-moto">Practicar</a>
                <a class="home-btn home-btn--secondary" href="/test-de-conducir/categoria-a/">Estudiar</a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="home-section home-section--white" aria-labelledby="requisitos">
      <div class="home-wrap home-split">
        <div>
          <p class="home-kicker">Alcance real</p>
          <h2 id="requisitos">Preguntas explicadas, con la fuente a la vista</h2>
          <p class="home-lede">
            Son {questionCount} preguntas por ciudad, armadas para practicar y contrastadas con
            normas y guías oficiales. No reproducen el banco del examen ni garantizan la aprobación.
          </p>
          <p class="home-note">
            Solo elegí tu ciudad y empezá. No pedimos registro ni datos personales. El historial de
            prácticas queda en tu dispositivo. Hoy podés practicar autos (clase B1) en práctica
            general, CABA y Córdoba Capital, y motos (categoría A).
          </p>
          <a class="home-btn home-btn--secondary" href="/fuentes-y-metodologia/">
            Ver fuentes y metodología
          </a>
        </div>
        {
          example && exampleSource && (
            <article class="home-q" aria-label="Ejemplo ilustrativo de una pregunta real">
              <span class="home-q__label">Ejemplo ilustrativo</span>
              <h3>{example.prompt}</h3>
              <ul class="home-q__options">
                {example.options.map((option) => {
                  const correct = option.id === example.correctOptionId;
                  return (
                    <li data-correct={String(correct)}>
                      <span>{option.text}</span>
                      {correct && (
                        <span class="home-q__ok" aria-hidden="true">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12.5 10 17l9-10"/></svg>
                        </span>
                      )}
                    </li>
                  );
                })}
              </ul>
              <div class="home-q__source">
                <strong>{exampleSource.title.split(':')[0]} · {exampleSource.locator}</strong>
                <a href={exampleSource.url}>Ver la fuente</a>
              </div>
            </article>
          )
        }
      </div>
    </section>

    <section class="home-section" aria-labelledby="faq-titulo">
      <div class="home-wrap">
        <div class="home-head">
          <p class="home-kicker">Dudas frecuentes</p>
          <h2 id="faq-titulo">Preguntas frecuentes</h2>
          <p class="home-lede">Lo esencial sobre qué es este sitio y hasta dónde llega.</p>
        </div>
        <div class="home-faq">
          <details>
            <summary>¿Esto es el examen oficial?</summary>
            <p>
              No. Es práctica independiente. No reproduce un examen oficial ni garantiza la
              aprobación.
            </p>
          </details>
          <details>
            <summary>¿Cuántas preguntas hay?</summary>
            <p>
              {questionCount} en cada banco (práctica general, CABA y Córdoba Capital). Podés
              practicar con 10, 20 o las {questionCount}. Si elegís {questionCount}, usás todas las
              disponibles: no se generan preguntas nuevas al azar.
            </p>
          </details>
          <details>
            <summary>¿Qué categorías se pueden practicar?</summary>
            <p>
              Autos (clase B1) en práctica general, CABA y Córdoba Capital, y motos (categoría A).
            </p>
          </details>
          <details>
            <summary>¿Córdoba Capital vale para toda la provincia?</summary>
            <p>
              No. El material se basa en la normativa de la ciudad de Córdoba. No aplica
              automáticamente a otros municipios.
            </p>
          </details>
          <details>
            <summary>¿De dónde salen las respuestas?</summary>
            <p>
              Cada pregunta cita la fuente y el artículo o página usados para contrastar la
              respuesta. El detalle está en <a href="/fuentes-y-metodologia/">Fuentes y metodología</a>.
            </p>
          </details>
        </div>
      </div>
    </section>

    <section class="home-section home-section--white" aria-labelledby="cta-final">
      <div class="home-wrap">
        <div class="home-final">
          <div class="home-ico home-ico--amarillo" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="2" width="6" height="20" rx="2"/><circle cx="12" cy="7" r="1.4" fill="currentColor"/><circle cx="12" cy="12" r="1.4" fill="currentColor"/><circle cx="12" cy="17" r="1.4" fill="currentColor"/></svg>
          </div>
          <div class="home-final__copy">
            <h2 id="cta-final">¿Listo para practicar el teórico?</h2>
            <p>Elegí la ciudad y practicá con explicación y fuente, antes de rendir.</p>
          </div>
          <a class="home-btn home-btn--primary" href="/#empezar">Empezar test →</a>
        </div>
      </div>
    </section>
  </div>
</Layout>
