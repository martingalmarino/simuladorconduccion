---
import Layout from '../components/Layout.astro';
import JurisdictionCard from '../components/JurisdictionCard.astro';
import PracticeLauncher from '../components/PracticeLauncher.astro';
import Illustrations from '../components/Illustrations.astro';
import UpcomingTestCard from '../components/UpcomingTestCard.astro';
import { getBank, getSiteConfig, getUpcomingTests } from '../lib/content';
import { absoluteUrl, getSiteRuntime } from '../lib/site';
import { topicLabel } from '../lib/topics';

const config = getSiteConfig();
const runtime = getSiteRuntime();
const cards = config.jurisdictions.map((j) => ({
  jurisdiction: j,
  bank: getBank(j.bankId),
}));
const upcomingTests = getUpcomingTests();
const questionCount = cards[0]?.bank.questions.length ?? 20;
const sampleTopics = [
  ...new Set(cards.flatMap((c) => c.bank.questions.map((q) => q.topic))),
].slice(0, 8);

const pageUrl = absoluteUrl('/');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: config.siteName,
    inLanguage: runtime.locale,
    ...(pageUrl ? { url: pageUrl } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Práctica Vial | Prepará tu examen teórico de conducir',
    inLanguage: runtime.locale,
    description:
      'Prepará el examen teórico de conducir con práctica general y tests por jurisdicción. Preguntas con respuestas explicadas, imágenes y fuentes para estudiar.',
    ...(pageUrl ? { url: pageUrl } : {}),
  },
];
---

<Layout
  title="Práctica Vial | Prepará tu examen teórico de conducir"
  description="Prepará el examen teórico de conducir con práctica general y tests por jurisdicción. Preguntas con respuestas explicadas, imágenes y fuentes para estudiar."
  pathname="/"
  jsonLd={jsonLd}
  fullBleed={true}
>
  <section class="hero container">
    <p class="kicker">Práctica Vial · Argentina</p>
    <h1>Prepará tu examen teórico de conducir</h1>
    <p class="lede">
      Practicá con preguntas tipo test, entendé cada respuesta y descubrí qué necesitás repasar antes
      de rendir.
    </p>

    <PracticeLauncher
      jurisdictions={config.jurisdictions}
      upcomingTests={upcomingTests}
      questionCount={questionCount}
      notice="Práctica independiente"
    />

    <div class="step-cards" aria-label="Cómo funciona la práctica">
      <article class="step-card">
        <div class="step-card__label">Paso 01</div>
        <div class="step-card__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-4.5 7-11a7 7 0 1 0-14 0c0 6.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
        </div>
        <h3>Elegí la ciudad</h3>
        <p>CABA o Córdoba Capital. No mezclamos normas entre jurisdicciones.</p>
        <a href="#jurisdicciones">Ver ciudades →</a>
      </article>
      <article class="step-card">
        <div class="step-card__label">Paso 02</div>
        <div class="step-card__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19h16M8 17V9m4 8V5m4 12v-4"/></svg>
        </div>
        <h3>Modo Aprender</h3>
        <p>10, 20 o {questionCount} preguntas, con explicación y fuente después de cada respuesta.</p>
        <a href="#como-practicar">Cómo funciona →</a>
      </article>
      <article class="step-card">
        <div class="step-card__label">Paso 03</div>
        <div class="step-card__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M8 12l2.5 2.5L16 9"/></svg>
        </div>
        <h3>Práctica</h3>
        <p>20 o {questionCount} preguntas. Corrección al final, con aciertos y temas a repasar.</p>
        <a href="#como-practicar">Ver modalidades →</a>
      </article>
      <article class="step-card">
        <div class="step-card__label">Paso 04</div>
        <div class="step-card__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5V6a2 2 0 0 1 2-2h9l5 5v10.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19.5z"/><path d="M14 4v5h5"/></svg>
        </div>
        <h3>Repasá con fuentes</h3>
        <p>Cada explicación enlaza la norma o guía consultada.</p>
        <a href="/fuentes-y-metodologia/">Metodología →</a>
      </article>
    </div>
  </section>

  <section class="section-block section-block--soft" aria-labelledby="para-que">
    <div class="container split">
      <div class="split__copy">
        <p class="kicker">Para qué sirve</p>
        <h2 id="para-que">¿Qué necesitás para practicar acá?</h2>
        <p class="lede">
          Solo elegí tu ciudad y empezá. No pedimos registro ni datos personales. El historial de
          prácticas queda en tu dispositivo.
        </p>
        <p class="muted">
          Hoy podés practicar <strong>autos (clase B1)</strong> en práctica general, CABA y Córdoba
          Capital. Las categorías A, E y D están anunciadas y todavía no tienen preguntas.
        </p>
      </div>
      <div class="split__visual">
        <Illustrations name="practice" />
      </div>
    </div>
  </section>

  <section class="section-block section-block--paper" aria-labelledby="requisitos">
    <div class="container split split--reverse">
      <div class="split__copy">
        <p class="kicker">Alcance real</p>
        <h2 id="requisitos">Preguntas explicadas, con la fuente a la vista</h2>
        <p class="lede">
          Son {questionCount} preguntas por ciudad, armadas para practicar y contrastadas con normas y
          guías oficiales. No reproducen el banco del examen ni garantizan la aprobación.
        </p>
        <div class="topic-chips" aria-label="Temas de ejemplo">
          {sampleTopics.map((topic) => <span class="chip">{topicLabel(topic)}</span>)}
        </div>
        <div class="btn-row" style="margin-top:1.25rem;">
          <a class="btn btn--secondary" href="/fuentes-y-metodologia/">Ver fuentes y metodología</a>
        </div>
      </div>
      <div class="split__visual">
        <Illustrations name="route" />
      </div>
    </div>
  </section>

  <section id="como-practicar" class="section-block section-block--soft" aria-labelledby="como-titulo">
    <div class="container">
      <div class="section-head">
        <p class="kicker">Modalidades</p>
        <h2 id="como-titulo">Los pasos para practicar bien</h2>
        <p class="lede">
          Dos formas de practicar: con corrección al instante o al final. Sin reloj ni nota oficial de
          “aprobado”.
        </p>
      </div>
      <div class="timeline">
        <article class="timeline-item">
          <div class="timeline-item__num" aria-hidden="true">01</div>
          <div>
            <h3>Elegí jurisdicción</h3>
            <p>CABA o Córdoba Capital. Cada banco responde a su propia normativa local.</p>
            <a href="#jurisdicciones">Ir a las ciudades →</a>
          </div>
        </article>
        <article class="timeline-item">
          <div class="timeline-item__num" aria-hidden="true">02</div>
          <div>
            <h3>Aprender con corrección inmediata</h3>
            <p>
              Elegís 10, 20 o {questionCount} preguntas. Después de responder ves la explicación y el
              enlace a la fuente.
            </p>
            <a href="#empezar">Empezar en modo Aprender →</a>
          </div>
        </article>
        <article class="timeline-item">
          <div class="timeline-item__num" aria-hidden="true">03</div>
          <div>
            <h3>Práctica con corrección al final</h3>
            <p>
              Podés hacer 20 o las {questionCount}. Al final ves aciertos, porcentaje, preguntas sin
              responder y temas a repasar. Es práctica, no un veredicto oficial.
            </p>
            <a href="#empezar">Configurar práctica →</a>
          </div>
        </article>
        <article class="timeline-item">
          <div class="timeline-item__num" aria-hidden="true">04</div>
          <div>
            <h3>Estudiá todas las preguntas</h3>
            <p>
              En la página de cada ciudad podés leer las {questionCount} preguntas con respuesta y
              fuente, sin necesidad de empezar una práctica.
            </p>
            <a href="/test-de-conducir/">Ver tests por ciudad →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="jurisdicciones" class="section-block section-block--paper" aria-labelledby="jurisdicciones-titulo">
    <div class="container">
      <div class="section-head">
        <p class="kicker">Jurisdicciones</p>
        <h2 id="jurisdicciones-titulo">Elegí dónde vas a practicar</h2>
        <p class="lede">
          Hoy hay práctica para autos en dos ciudades. Cada una usa su propia normativa local.
        </p>
      </div>
      <div class="card-grid">
        {
          cards.map(({ jurisdiction, bank }) => (
            <JurisdictionCard jurisdiction={jurisdiction} bank={bank} />
          ))
        }
      </div>
    </div>
  </section>

  <section id="proximamente" class="section-block section-block--soft" aria-labelledby="proximamente-titulo">
    <div class="container">
      <div class="section-head">
        <p class="kicker">Próximamente</p>
        <h2 id="proximamente-titulo">Otras categorías, próximamente</h2>
        <p class="lede">
          Estas categorías ya están anunciadas. Todavía no hay preguntas para practicarlas.
        </p>
      </div>
      <div class="card-grid">
        {upcomingTests.map((test) => <UpcomingTestCard test={test} />)}
      </div>
    </div>
  </section>

  <section class="section-block section-block--paper" aria-labelledby="faq-titulo">
    <div class="container">
      <div class="section-head">
        <p class="kicker">Dudas frecuentes</p>
        <h2 id="faq-titulo">Preguntas frecuentes</h2>
        <p class="lede">Lo esencial sobre qué es este sitio y hasta dónde llega.</p>
      </div>
      <div class="faq">
        <details open>
          <summary>¿Esto es el examen oficial?</summary>
          <p>
            No. Es práctica independiente. No reproduce un examen oficial ni garantiza la aprobación.
          </p>
        </details>
        <details>
          <summary>¿Cuántas preguntas hay?</summary>
          <p>
            {questionCount} en cada banco (práctica general, CABA y Córdoba Capital). Podés practicar
            con 10, 20 o las {questionCount}. Si elegís {questionCount}, usás todas las disponibles:
            no se generan preguntas nuevas al azar.
          </p>
        </details>
        <details>
          <summary>¿Por qué solo se puede practicar autos?</summary>
          <p>
            Por ahora el material publicado es para autos (clase B1). Las categorías A (motos), E
            (carga) y D (pasajeros) están anunciadas y todavía no tienen preguntas.
          </p>
        </details>
        <details>
          <summary>¿Córdoba Capital vale para toda la provincia?</summary>
          <p>
            No. El material se basa en la normativa de la ciudad de Córdoba. No aplica automáticamente
            a otros municipios.
          </p>
        </details>
        <details>
          <summary>¿De dónde salen las respuestas?</summary>
          <p>
            Cada pregunta cita la fuente y el artículo o página usados para contrastar la respuesta.
            El detalle está en <a href="/fuentes-y-metodologia/">Fuentes y metodología</a>.
          </p>
        </details>
      </div>
    </div>
  </section>
</Layout>
