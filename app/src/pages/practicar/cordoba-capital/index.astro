---
import Layout from '../../../components/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import QuizApp from '../../../components/quiz/QuizApp';
import {
  getContentVersion,
  getPracticeModesForJurisdiction,
  getQuestionsForSlug,
  getSiteConfig,
  prepareQuestionsForClient,
  requireJurisdiction,
} from '../../../lib/content';

const slug = 'cordoba-capital';
const jurisdiction = requireJurisdiction(slug);
const config = getSiteConfig();
const prepared = prepareQuestionsForClient(getQuestionsForSlug(slug));
const contentVersion = getContentVersion();
const practiceModes = getPracticeModesForJurisdiction(jurisdiction);
---

<Layout
  title={`Practicar test de conducir · ${jurisdiction.label}`}
  description={`Sesión interactiva de práctica para autos en ${jurisdiction.label}. No indexable.`}
  pathname={`/practicar/${slug}/`}
  noindex={true}
>
  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Córdoba Capital', href: `/test-de-conducir/${slug}/` },
      { label: 'Practicar' },
    ]}
  />

  <QuizApp
    client:load
    jurisdiction={jurisdiction}
    questions={prepared}
    practiceModes={practiceModes}
    contentVersion={contentVersion}
    notice={jurisdiction.notice ?? config.notice}
  />
</Layout>
