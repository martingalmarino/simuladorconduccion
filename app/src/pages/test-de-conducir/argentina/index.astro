---
import Layout from '../../../components/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FactCards from '../../../components/FactCards.astro';
import StudyQuestion from '../../../components/StudyQuestion.astro';
import {
  getBankForSlug,
  groupQuestionsByTopic,
  requireJurisdiction,
  sourcesForJurisdiction,
} from '../../../lib/content';
import { formatSourceDate, studyGraph, type FaqItem } from '../../../lib/studyGraph';
import { topicLabel } from '../../../lib/topics';

const slug = 'argentina';
const jurisdiction = requireJurisdiction(slug);
const bank = getBankForSlug(slug);
const groups = groupQuestionsByTopic(bank.questions);
const sources = sourcesForJurisdiction(jurisdiction.id);
const updated = sources.map((source) => source.accessedAt).sort().at(-1) ?? '2026-10-21';
let questionIndex = 0;

const title = 'Test de conducir Argentina 2026: 50 preguntas explicadas';
const description =
  'Practicá gratis el examen teórico de la Licencia Nacional de Conducir con 50 preguntas sobre la Ley 24.449, con respuesta explicada y fuente oficial.';

const faq: FaqItem[] = [
  {
    question: '¿El test de conducir es igual en todo el país?',
    answer:
      'No exactamente. La Ley Nacional de Tránsito 24.449 es la base común, pero cada municipio o jurisdicción toma el examen en su Centro de Emisión de Licencias y define cantidad de preguntas, tiempo y material de estudio. Por eso conviene practicar la normativa nacional y también la local.',
  },
  {
    question: '¿Qué ley tengo que estudiar para el examen teórico?',
    answer:
      'La Ley 24.449 de Tránsito y Seguridad Vial y su reglamentación, el Decreto 779/95, más el código o la ordenanza de tránsito de tu jurisdicción si tiene uno propio.',
  },
  {
    question: '¿A qué edad puedo sacar la licencia de conducir de auto?',
    answer:
      'La clase B1 se puede solicitar desde los 17 años con autorización de padre, madre o tutor, según la ANSV.',
  },
  {
    question: '¿Es obligatorio hacer un curso para sacar la licencia por primera vez?',
    answer:
      'Sí. La Ley 24.449 exige un curso teórico-práctico de educación vial. La ANSV ofrece el Curso Nacional de Educación Vial Digital, gratuito y online, cuyo certificado se presenta en el CEL de tu domicilio.',
  },
  {
    question: '¿Este test es el examen oficial?',
    answer:
      'No. Es una práctica independiente basada en fuentes oficiales para que estudies y detectes tus errores antes de rendir.',
  },
  {
    question: '¿Puedo practicar online gratis?',
    answer:
      'Sí. Podés leer las 50 preguntas con sus explicaciones en esta página o hacer la práctica interactiva sin registrarte.',
  },
];

const extraSources = [
  {
    title: 'ANSV — Clases y subclases de la Licencia Nacional de Conducir',
    url: 'https://www.argentina.gob.ar/seguridadvial/licencianacional/clasesysubclases',
  },
  {
    title: 'Curso Nacional de Educación Vial',
    url: 'https://www.argentina.gob.ar/servicio/realizar-el-curso-nacional-de-seguridad-vial-para-obtener-la-licencia',
  },
];

const jsonLd = studyGraph({
  pathname: `/test-de-conducir/${slug}/`,
  title,
  description,
  dateModified: updated,
  quizName: '50 preguntas del test de conducir Argentina (clase B1)',
  legislationName: 'Ley 24.449 de Tránsito y Seguridad Vial',
  coverageType: 'Country',
  coverageName: 'Argentina',
  quizAbout: 'Ley Nacional de Tránsito 24.449',
  citations: [...sources.map((source) => source.url), ...extraSources.map((source) => source.url)],
  breadcrumbName: 'Argentina',
  faq,
});
---

<Layout
  title={title}
  description={description}
  pathname={`/test-de-conducir/${slug}/`}
  exactTitle={true}
  jsonLd={jsonLd}
>
  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Tests', href: '/test-de-conducir/' },
      { label: 'Argentina' },
    ]}
  />

  <h1>Test de conducir Argentina: 50 preguntas del teórico nacional</h1>
  <p class="lede">
    Practicá para el examen teórico de la Licencia Nacional de Conducir con 50 preguntas para autos
    (clase B1) basadas en la Ley Nacional de Tránsito 24.449 y su reglamentación (Decreto 779/95).
    Cada pregunta tiene la respuesta correcta, una explicación breve y la fuente oficial. Es una
    práctica gratuita e independiente: no es un examen oficial y conviene complementarla con el
    material de tu municipio.
  </p>
  <p class="muted">
    Actualizado: <time datetime={updated}>{formatSourceDate(updated)}</time>
  </p>

  <div class="btn-row">
    <a class="btn btn--primary" href={`/practicar/${slug}/`}>Empezar a practicar</a>
    <a class="btn btn--secondary" href="#banco-completo">Ver las {bank.questions.length} preguntas</a>
  </div>

  <section class="section" aria-labelledby="respuesta-rapida">
    <h2 id="respuesta-rapida">¿Qué se evalúa en el examen teórico de conducir en Argentina?</h2>
    <FactCards
      cards={[
        {
          title: 'Qué tenés que aprobar',
          icon: 'list',
          items: [
            'Examen teórico de conducción, señalamiento y legislación',
            'Curso de educación vial',
            'Examen psicofísico',
            'Detección de fallas del vehículo',
            'Examen práctico',
          ],
          note: 'Aplica a la primera Licencia Nacional de Conducir.',
        },
        {
          title: 'La base común',
          icon: 'book',
          items: ['Ley 24.449', 'Reglamentación: Decreto 779/95'],
          note: 'Cada municipio define el formato del examen.',
        },
      ]}
    />
  </section>

  <section class="section" aria-labelledby="como-es-el-examen">
    <h2 id="como-es-el-examen">Cómo es el trámite de la Licencia Nacional de Conducir</h2>
    <FactCards
      cards={[
        {
          title: 'Requisitos',
          icon: 'user',
          items: [
            'DNI',
            'Saber leer',
            'Boleta de pago CENAT',
            'Si sos menor, autorización de tu representante legal',
          ],
          note: 'Según la ANSV, para una licencia particular.',
        },
        {
          title: 'Edad para la clase B1',
          icon: 'calendar',
          items: [
            'Desde los 17 años',
            'Autorización de padre, madre o tutor',
            'Autos, camionetas y utilitarios hasta 3.500 kg',
          ],
          note: 'Las autoridades locales pueden fijar requisitos adicionales.',
        },
        {
          title: 'Curso nacional',
          icon: 'book',
          items: [
            'Obligatorio para la primera licencia',
            'Curso Nacional de Educación Vial Digital, gratuito y online',
            'Certificado para el Centro de Emisión de Licencias de tu domicilio',
          ],
          note: 'Consultá antes los requisitos de tu municipio.',
        },
        {
          title: 'También la normativa local',
          icon: 'pin',
          items: [
            'El examen lo toma cada Centro de Emisión de Licencias',
            'CABA tiene código propio: Ley 2148',
            'Córdoba Capital tiene código propio: Ordenanza 9981',
          ],
          note: 'Si rendís ahí, usá también la práctica específica.',
        },
      ]}
    />
  </section>

  <section class="section" aria-labelledby="temas-ar">
    <h2 id="temas-ar">Temas del examen teórico nacional que practicás</h2>
    <div class="topic-chips">
      {groups.map((g) => <span class="chip">{topicLabel(g.topic)} ({g.questions.length})</span>)}
    </div>
  </section>

  <section id="banco-completo" class="section" aria-labelledby="banco-ar-titulo">
    <h2 id="banco-ar-titulo">50 preguntas del test de conducir con respuestas explicadas</h2>
    <p class="muted">
      Cada pregunta incluye la respuesta correcta, la explicación y la fuente.
    </p>
    {
      groups.map((group) => (
        <div class="stack" style="margin-top:1.5rem;">
          <h3 style="font-size:1.15rem;">{topicLabel(group.topic)}</h3>
          {group.questions.map((question) => {
            questionIndex += 1;
            return <StudyQuestion question={question} index={questionIndex} />;
          })}
        </div>
      ))
    }
  </section>

  <section class="section" aria-labelledby="faq">
    <h2 id="faq">Preguntas frecuentes sobre el test de conducir en Argentina</h2>
    <div class="faq">
      {
        faq.map((item, index) => (
          <details open={index === 0}>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="fuentes-ar">
    <h2 id="fuentes-ar">Fuentes oficiales consultadas</h2>
    <ul class="source-list">
      {
        sources.map((source) => (
          <li>
            <a href={source.url} rel="noopener noreferrer" target="_blank">
              {source.title}
            </a>
            <span class="muted"> · consultado {source.accessedAt}</span>
          </li>
        ))
      }
      {
        extraSources.map((source) => (
          <li>
            <a href={source.url} rel="noopener noreferrer" target="_blank">
              {source.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="otras-practicas">
    <h2 id="otras-practicas">Otras prácticas</h2>
    <ul>
      <li><a href="/test-de-conducir/caba/">Test de conducir CABA</a></li>
      <li><a href="/test-de-conducir/cordoba-capital/">Test de conducir Córdoba Capital</a></li>
      <li><a href="/practicar/argentina/">Práctica interactiva nacional</a></li>
      <li><a href="/fuentes-y-metodologia/">Fuentes y metodología</a></li>
    </ul>
  </section>
</Layout>
