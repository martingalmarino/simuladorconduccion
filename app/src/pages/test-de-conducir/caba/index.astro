---
import Layout from '../../../components/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FactCards from '../../../components/FactCards.astro';
import StudyQuestion from '../../../components/StudyQuestion.astro';
import {
  getBankForSlug,
  groupQuestionsByTopic,
  requireJurisdiction,
  sourcesForJurisdiction,
} from '../../../lib/content';
import { formatSourceDate, studyGraph, type FaqItem } from '../../../lib/studyGraph';
import { topicLabel } from '../../../lib/topics';
import RoadSigns from '../../../components/ui/RoadSigns.astro';

const slug = 'caba';
const jurisdiction = requireJurisdiction(slug);
const bank = getBankForSlug(slug);
const groups = groupQuestionsByTopic(bank.questions);
const sources = sourcesForJurisdiction(jurisdiction.id);
const updated = sources.map((source) => source.accessedAt).sort().at(-1) ?? '2026-10-20';
let questionIndex = 0;

const title = 'Test de conducir CABA 2026: simulador del examen teórico';
const description =
  'Practicá el examen teórico de CABA para auto (B1): 50 preguntas con respuesta explicada según la Ley 2148 y el manual oficial. Gratis y sin registro.';

const faq: FaqItem[] = [
  {
    question: '¿Cuántas preguntas tiene el examen teórico de CABA?',
    answer:
      'Según el Gobierno de la Ciudad, el examen tiene 40 preguntas de opción múltiple y para aprobarlo tenés que contestar bien 34.',
  },
  {
    question: '¿Qué pasa si no apruebo el teórico en CABA?',
    answer:
      'Podés reprogramar o volver a rendir pidiendo un turno de reevaluación, según la información del trámite en buenosaires.gob.ar.',
  },
  {
    question: '¿Qué material tengo que estudiar para el teórico de auto en CABA?',
    answer:
      'El Manual de Conducción Vehicular Teórica que publica el Gobierno de la Ciudad, basado en el Código de Tránsito y Transporte (Ley 2148).',
  },
  {
    question: '¿Tengo que llevar mi auto al examen práctico en CABA?',
    answer:
      'Para B1, la Ciudad informa que el práctico se hace en la calle con autos doble comando provistos por el Gobierno, manuales o automáticos. La modalidad elegida no se puede cambiar el día del examen.',
  },
  {
    question: '¿Este test sirve para la Provincia de Buenos Aires?',
    answer:
      'No está pensado para eso. Las preguntas se basan en la normativa de la Ciudad Autónoma de Buenos Aires; para la base nacional usá el test de conducir de Argentina.',
  },
  {
    question: '¿Este simulador es el examen oficial de CABA?',
    answer: 'No. Es una práctica independiente con fuentes oficiales para que llegues mejor preparado.',
  },
];

const extraSources = [
  {
    title: 'GCBA — Otorgamiento de licencia de conducir',
    url: 'https://buenosaires.gob.ar/tramites/otorgamiento-de-licencia-de-conducir',
  },
  {
    title: 'GCBA — Nueva modalidad de otorgamiento (Ley 6486)',
    url: 'https://buenosaires.gob.ar/licenciasdeconducir/conoce-la-nueva-modalidad-de-otorgamiento-de-licencias-de-conducir',
  },
];

const jsonLd = studyGraph({
  pathname: `/test-de-conducir/${slug}/`,
  title,
  description,
  dateModified: updated,
  quizName: '50 preguntas del examen teórico de conducir de CABA (clase B1)',
  legislationName: 'Código de Tránsito y Transporte de la Ciudad de Buenos Aires (Ley 2148)',
  coverageType: 'AdministrativeArea',
  coverageName: 'Ciudad Autónoma de Buenos Aires',
  quizAbout: 'Normas de tránsito de CABA',
  citations: [...sources.map((source) => source.url), ...extraSources.map((source) => source.url)],
  breadcrumbName: 'CABA',
  faq,
});
---

<Layout
  title={title}
  description={description}
  pathname={`/test-de-conducir/${slug}/`}
  exactTitle={true}
  jsonLd={jsonLd}
>
  <div class="guide-hero">
    <div>
  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Tests', href: '/test-de-conducir/' },
      { label: 'CABA' },
    ]}
  />

  <h1>Test de conducir CABA: practicá el examen teórico de auto (B1)</h1>
  <p class="lede">
    Prepará el examen teórico de la licencia de conducir en la Ciudad de Buenos Aires con 50
    preguntas para autos (clase B1). Están basadas en el Código de Tránsito y Transporte de CABA (Ley
    2148) y en el Manual de Conducción Vehicular Teórica del Gobierno de la Ciudad. Cada respuesta
    tiene explicación y fuente. Es una práctica independiente: no es el examen oficial ni el temario
    completo.
  </p>
  <p class="muted">
    Actualizado: <time datetime={updated}>{formatSourceDate(updated)}</time>
  </p>

  <div class="btn-row">
    <a class="btn btn--primary" href={`/practicar/${slug}/`}>Empezar a practicar</a>
    <a class="btn btn--secondary" href="#banco-completo">Ver las {bank.questions.length} preguntas</a>
  </div>
    </div>
    <RoadSigns />
  </div>

  <section class="section" aria-labelledby="respuesta-rapida">
    <h2 id="respuesta-rapida">¿Cómo es el examen teórico en CABA?</h2>
    <FactCards
      cards={[
        {
          title: 'Formato del teórico',
          icon: 'list',
          items: [
            '40 preguntas de opción múltiple',
            '34 respuestas correctas para aprobar',
            'Si no aprobás, podés pedir turno de reevaluación',
          ],
          note: 'Según el Gobierno de la Ciudad. Con la Ley de Convivencia Vial (Ley 6486), antes había que acertar 23 de 30.',
        },
        {
          title: 'Material de estudio',
          icon: 'book',
          items: ['Manual de conducción de vehículos de cuatro ruedas'],
          note: 'Es el material obligatorio para autos y está online en buenosaires.gob.ar.',
        },
      ]}
    />
  </section>

  <section class="section" aria-labelledby="como-es-el-examen">
    <h2 id="como-es-el-examen">Cómo es el examen de conducir en CABA</h2>
    <FactCards
      cards={[
        {
          title: 'Qué tenés que estudiar',
          icon: 'book',
          items: [
            'Manual de Conducción Vehicular Teórica',
            'Anexo de la Resolución SECTOP 508/23',
            'Basado en el Código de Tránsito y Transporte',
          ],
        },
        {
          title: 'Temas que más se repiten',
          icon: 'list',
          items: [
            'Semáforos y prioridades',
            'Velocidades',
            'Alcohol, cinturón y retención infantil',
            'Autopistas y estacionamiento',
          ],
        },
        {
          title: 'Pasos del trámite',
          icon: 'user',
          items: [
            'Evaluación psicofísica: psicología, visión, audición y médica',
            'Examen teórico',
            'Examen práctico',
          ],
          note: 'Verificá los requisitos actualizados en buenosaires.gob.ar antes de sacar turno.',
        },
        {
          title: 'El práctico de B1',
          icon: 'car',
          items: [
            'Se hace en la calle',
            'Autos doble comando del Gobierno de la Ciudad',
            'Transmisión manual o automática, a elección',
          ],
        },
      ]}
    />
  </section>

  <section class="section" aria-labelledby="temas-caba">
    <h2 id="temas-caba">Temas del examen teórico de CABA que practicás</h2>
    <div class="topic-chips">
      {groups.map((g) => <span class="chip">{topicLabel(g.topic)} ({g.questions.length})</span>)}
    </div>
  </section>

  <section id="banco-completo" class="section" aria-labelledby="banco-caba-titulo">
    <h2 id="banco-caba-titulo">50 preguntas del examen de conducir de CABA con respuestas</h2>
    <p class="muted">
      Cada pregunta incluye la respuesta correcta, la explicación y la fuente.
    </p>
    {
      groups.map((group) => (
        <div class="stack" style="margin-top:1.5rem;">
          <h3 style="font-size:1.15rem;">{topicLabel(group.topic)}</h3>
          {group.questions.map((question) => {
            questionIndex += 1;
            return <StudyQuestion question={question} index={questionIndex} />;
          })}
        </div>
      ))
    }
  </section>

  <section class="section" aria-labelledby="faq">
    <h2 id="faq">Preguntas frecuentes sobre el examen de conducir en CABA</h2>
    <div class="faq">
      {
        faq.map((item, index) => (
          <details open={index === 0}>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="fuentes-caba">
    <h2 id="fuentes-caba">Fuentes oficiales consultadas</h2>
    <ul class="source-list">
      {
        sources.map((source) => (
          <li>
            <a href={source.url} rel="noopener noreferrer" target="_blank">
              {source.title}
            </a>
            <span class="muted"> · consultado {source.accessedAt}</span>
          </li>
        ))
      }
      {
        extraSources.map((source) => (
          <li>
            <a href={source.url} rel="noopener noreferrer" target="_blank">
              {source.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="otras-practicas">
    <h2 id="otras-practicas">Otras prácticas</h2>
    <ul>
      <li>
        <a href="/test-de-conducir/argentina/">Test de conducir Argentina (normativa nacional)</a>
      </li>
      <li><a href="/test-de-conducir/cordoba-capital/">Test de conducir Córdoba Capital</a></li>
      <li><a href="/practicar/caba/">Práctica interactiva de CABA</a></li>
      <li><a href="/fuentes-y-metodologia/">Fuentes y metodología</a></li>
    </ul>
  </section>
</Layout>
