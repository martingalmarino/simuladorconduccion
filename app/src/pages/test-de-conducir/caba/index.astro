---
import Layout from '../../../components/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import StudyQuestion from '../../../components/StudyQuestion.astro';
import {
  getBankForSlug,
  groupQuestionsByTopic,
  requireJurisdiction,
  sourcesForJurisdiction,
} from '../../../lib/content';
import { absoluteUrl, getSiteRuntime } from '../../../lib/site';
import { topicLabel } from '../../../lib/topics';

const slug = 'caba';
const jurisdiction = requireJurisdiction(slug);
const bank = getBankForSlug(slug);
const groups = groupQuestionsByTopic(bank.questions);
const sources = sourcesForJurisdiction(jurisdiction.id);
const runtime = getSiteRuntime();
const pageUrl = absoluteUrl(`/test-de-conducir/${slug}/`);
let questionIndex = 0;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Practicá el test de conducir de autos en CABA',
    inLanguage: runtime.locale,
    description: bank.coverage,
    ...(pageUrl ? { url: pageUrl } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Inicio',
        ...(absoluteUrl('/') ? { item: absoluteUrl('/') } : {}),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Tests',
        ...(absoluteUrl('/test-de-conducir/')
          ? { item: absoluteUrl('/test-de-conducir/') }
          : {}),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'CABA',
        ...(pageUrl ? { item: pageUrl } : {}),
      },
    ],
  },
];
---

<Layout
  title="Test de conducir CABA: preguntas explicadas para autos"
  description={`Muestra introductoria de ${bank.questions.length} preguntas para el test teórico de autos en CABA, con explicación y fuente. No es el temario completo ni un examen oficial.`}
  pathname={`/test-de-conducir/${slug}/`}
  jsonLd={jsonLd}
>
  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Tests', href: '/test-de-conducir/' },
      { label: 'CABA' },
    ]}
  />

  <h1>Practicá el test de conducir de autos en CABA</h1>
  <p class="lede">
    Hay una muestra introductoria de <strong>{bank.questions.length} preguntas</strong> para autos
    (B1 introductorio) en la Ciudad Autónoma de Buenos Aires. Podés estudiarlas acá en HTML o abrir la
    práctica interactiva. {bank.coverage}
  </p>

  <div class="btn-row">
    <a class="btn btn--primary" href={`/practicar/${slug}/`}>Empezar a practicar</a>
    <a class="btn btn--secondary" href="#banco-completo">Ver las {bank.questions.length} preguntas</a>
  </div>

  <section class="section notice">
    <p style="margin:0 0 0.5rem;">
      <strong>Alcance:</strong> {jurisdiction.geographicScope}. Clases: {jurisdiction.licenseClasses.join(', ')}.
      No es el programa completo del examen.
    </p>
    <p style="margin:0;" class="muted">Fecha de consulta de fuentes del banco: 2026-10-20.</p>
  </section>

  <section class="section" aria-labelledby="temas-caba">
    <h2 id="temas-caba">Temas incluidos</h2>
    <div class="topic-chips">
      {groups.map((g) => <span class="chip">{topicLabel(g.topic)} ({g.questions.length})</span>)}
    </div>
  </section>

  <section class="section" aria-labelledby="fuentes-caba">
    <h2 id="fuentes-caba">Fuentes útiles</h2>
    <ul class="source-list">
      {
        sources.map((source) => (
          <li>
            <a href={source.url} rel="noopener noreferrer" target="_blank">
              {source.title}
            </a>
            <span class="muted"> · consultado {source.accessedAt}</span>
          </li>
        ))
      }
    </ul>
    <p class="muted">
      Detalle de metodología y límites en
      <a href="/fuentes-y-metodologia/">Fuentes y metodología</a>.
    </p>
  </section>

  <section id="banco-completo" class="section" aria-labelledby="banco-caba-titulo">
    <h2 id="banco-caba-titulo">Las {bank.questions.length} preguntas de estudio</h2>
    <p class="muted">
      Respuestas y explicaciones están en el HTML inicial. Cada pregunta tiene un enlace directo con su ID
      (por ejemplo <a href="#caba-b1-001">#caba-b1-001</a>).
    </p>

    {
      groups.map((group) => (
        <div class="stack" style="margin-top:1.5rem;">
          <h3 style="font-size:1.15rem;">{topicLabel(group.topic)}</h3>
          {group.questions.map((question) => {
            questionIndex += 1;
            return <StudyQuestion question={question} index={questionIndex} />;
          })}
        </div>
      ))
    }
  </section>
</Layout>
