---
import PageShell from '../../../components/categoria-a/PageShell.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FactCards from '../../../components/FactCards.astro';
import QuizCategoria from '../../../components/QuizCategoria.astro';
import RoadSigns from '../../../components/ui/RoadSigns.astro';
import banco from '../../../data/preguntas-categoria-a.json';

const pathname = '/test-de-conducir/categoria-a/';
const pageUrl = `https://www.practicavial.com.ar${pathname}`;
const total = banco.preguntas.length;
const title = 'Test teórico de moto (categoría A): subclases y requisitos';
let description = `Practicá el teórico de moto (categoría A) con ${total} preguntas explicadas: subclases A.1 a A.3, casco, velocidades y edades, con fuente oficial. Gratis.`;
if (description.length > 155) description = description.replace(/ Gratis\.$/, '');
if (title.length > 60 || description.length > 155) {
  throw new Error(`Meta fuera de límite: title ${title.length}, description ${description.length}`);
}

const quizHeading = `Practicá el test de moto: ${total} preguntas con respuesta explicada`;
const actualizado = '2026-10-23';

const faq = [
  {
    question: '¿Qué licencia necesito para una moto de 125 cc?',
    answer:
      'La subclase A.1.2, que cubre motos de hasta 150 cc u 11 kW. La edad mínima es de 17 años, según la ANSV.',
  },
  {
    question: '¿Desde qué edad puedo sacar la licencia de moto?',
    answer:
      'Desde los 16 años para ciclomotores de hasta 50 cc sin pasajero (A.1.1). Para motos de hasta 150 cc, desde los 17; de más de 150 hasta 300 cc, desde los 19; y de más de 300 cc, desde los 21.',
  },
  {
    question: '¿La categoría A incluye cuatriciclos?',
    answer:
      'Sí. Los triciclos y cuatriciclos sin cabina van en A.2 y los que tienen cabina y volante, en A.3.',
  },
  {
    question: '¿El teórico de moto es distinto del de auto?',
    answer:
      'Comparte la normativa general de la Ley 24.449 y suma temas propios de los motovehículos, como el casco obligatorio. El contenido exacto lo define cada municipio.',
  },
  {
    question: '¿Qué necesito para una moto de más de 300 cc?',
    answer:
      'La subclase A.1.4. Pide 21 años y haber tenido 2 años la A.1.3, o 1 año si sos mayor de 21.',
  },
  {
    question: '¿La moto tiene que llevar matafuego y balizas?',
    answer:
      'No. La Ley 24.449 exige matafuego y balizas portátiles a los automotores, excepto a las motocicletas (art. 40 inc. f).',
  },
];

const subclases = [
  ['A.1.1', 'Ciclomotor hasta 50 cc o 4 kW', '16'],
  ['A.1.2', 'Moto hasta 150 cc o 11 kW', '17'],
  [
    'A.1.3',
    'Moto de más de 150 cc y hasta 300 cc (2 años en A.1.2, salvo mayores de 21)',
    '19',
  ],
  [
    'A.1.4',
    'Moto de más de 300 cc (2 años en A.1.3, o 1 año para mayores de 21)',
    '21',
  ],
  ['A.2.1', 'Triciclo/cuatriciclo sin cabina hasta 300 cc', '17'],
  ['A.2.2', 'Triciclo/cuatriciclo sin cabina de más de 300 cc', '19'],
  ['A.3', 'Triciclo/cuatriciclo con cabina y volante', '17'],
];

const temasMoto = [
  {
    title: 'Casco y anteojos',
    text: 'Todos los ocupantes deben usar casco normalizado y, si la moto no tiene parabrisas, el conductor tiene que usar anteojos (art. 40 inc. j). Manejar con un ocupante sin casco bien colocado es falta grave (art. 77 inc. s). La reglamentación exige certificación ECE R22-05.',
  },
  {
    title: 'Documentación',
    text: 'Licencia, cédula y seguro obligatorio (arts. 40 y 68). A diferencia del auto, la moto no lleva matafuego ni balizas (art. 40 inc. f).',
  },
  {
    title: 'Velocidades',
    text: '110 km/h en zona rural, 120 en semiautopista y 130 en autopista. En la ciudad, 40 km/h en calles y 60 en avenidas (art. 51).',
  },
  {
    title: 'Ciclomotores',
    text: 'No pueden circular por autopistas ni semiautopistas (art. 46). Los menores de 18 no pueden manejarlos en zonas céntricas ni en vías rápidas (art. 48 inc. e).',
  },
  {
    title: 'Conducción segura',
    text: 'Está prohibido zigzaguear, circular agarrado de otro vehículo o pegado detrás de otro automotor (art. 48 inc. d y m), y la alcoholemia permitida es cero (art. 48 inc. a).',
  },
  {
    title: 'Neumáticos',
    text: 'Profundidad mínima del dibujo: 1 mm en motos y 0,5 mm en ciclomotores (reglamentación, texto del Decreto 196/2025).',
  },
];

const grupos = [...new Set(banco.preguntas.map((pregunta) => pregunta.tema))].map((tema) => ({
  tema,
  preguntas: banco.preguntas.filter((pregunta) => pregunta.tema === tema),
}));
let questionIndex = 0;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      inLanguage: 'es-AR',
      dateModified: '2026-10-23',
      spatialCoverage: { '@type': 'Country', name: 'Argentina' },
      about: [
        {
          '@type': 'Legislation',
          name: 'Ley 24.449 de Tránsito y Seguridad Vial',
          url: 'https://servicios.infoleg.gob.ar/infolegInternet/anexos/0-4999/818/texact.htm',
        },
        {
          '@type': 'Legislation',
          name: 'Decreto 196/2025',
          url: 'https://www.argentina.gob.ar/normativa/nacional/decreto-196-2025-410682/texto',
        },
      ],
      citation: ['https://www.argentina.gob.ar/seguridadvial/licencianacional/clasesysubclases'],
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      mainEntity: { '@id': `${pageUrl}#quiz` },
    },
    {
      '@type': 'Quiz',
      '@id': `${pageUrl}#quiz`,
      name: 'Test teórico de moto: licencia categoría A',
      inLanguage: 'es-AR',
      isAccessibleForFree: true,
      educationalLevel: 'Licencia de conducir clase A',
      about: { '@type': 'Thing', name: 'Licencia Nacional de Conducir clase A' },
      numberOfQuestions: total,
      hasPart: banco.preguntas.map((pregunta) => ({
        '@type': 'Question',
        eduQuestionType: 'Multiple choice',
        name: pregunta.pregunta,
        acceptedAnswer: {
          '@type': 'Answer',
          text: pregunta.opciones[pregunta.correcta],
        },
        suggestedAnswer: pregunta.opciones
          .filter((_, index) => index !== pregunta.correcta)
          .map((text) => ({ '@type': 'Answer', text })),
        citation: pregunta.fuente.url,
      })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://www.practicavial.com.ar/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Test de conducir',
          item: 'https://www.practicavial.com.ar/test-de-conducir/',
        },
        { '@type': 'ListItem', position: 3, name: 'Categoría A' },
      ],
    },
  ],
};
---

<PageShell
  title={title}
  description={description}
  pathname={pathname}
  exactTitle={true}
  jsonLd={jsonLd}
>
  <script is:inline>
    if (location.href.endsWith('?')) {
      history.replaceState(null, '', location.pathname + location.hash);
    }
  </script>
  <div class="guide-hero">
    <div>
      <Breadcrumbs
        items={[
          { label: 'Inicio', href: '/' },
          { label: 'Tests', href: '/test-de-conducir/' },
          { label: 'Categoría A' },
        ]}
      />

      <h1>Test teórico de moto: licencia categoría A</h1>
      <p class="lede">
        La categoría A habilita a manejar ciclomotores, motos, triciclos y cuatriciclos. Practicá el
        teórico con preguntas basadas en la Ley 24.449, su reglamentación y la ANSV: cada respuesta
        tiene explicación y su fuente oficial. Abajo tenés también las subclases según la cilindrada y
        la edad mínima de cada una.
      </p>
      <p class="muted">
        Actualizado: <time datetime={actualizado}>23/10/2026</time>
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href="#test-moto">Empezar a practicar</a>
        <a class="btn btn--secondary" href="#banco-completo">Ver las {total} preguntas</a>
      </div>
    </div>
    <RoadSigns />
  </div>

  <section class="section" aria-labelledby="respuesta-rapida">
    <h2 id="respuesta-rapida">¿Cómo es el teórico de moto?</h2>
    <FactCards
      cards={[
        {
          title: 'Qué habilita',
          icon: 'list',
          items: [
            'A.1: ciclomotores y motos de dos ruedas',
            'A.2: triciclos y cuatriciclos sin cabina',
            'A.3: triciclos y cuatriciclos con cabina y volante',
          ],
        },
        {
          title: 'Edades mínimas',
          icon: 'calendar',
          items: [
            '16 años: ciclomotor de hasta 50 cc, sin pasajero',
            '17 años: motos de hasta 150 cc, A.2.1 y A.3',
            '19 años: motos de más de 150 cc y hasta 300 cc, y A.2.2',
            '21 años: motos de más de 300 cc',
          ],
        },
        {
          title: 'Qué se estudia',
          icon: 'book',
          items: ['Ley 24.449', 'Su reglamentación', 'Decreto 196/2025', 'ANSV'],
        },
        {
          title: 'Principiantes',
          icon: 'user',
          items: [
            'Durante los primeros 6 meses, cartel identificatorio',
            'Prohibición de circular por zonas céntricas, autopistas y semiautopistas',
          ],
          note: 'Los cursos, exámenes y turnos los define cada municipio',
        },
      ]}
    />
  </section>

  <section id="test-moto" class="section" aria-labelledby="test-moto-titulo">
    <h2 id="test-moto-titulo">{quizHeading}</h2>
    <div class="card quiz-frame">
      <QuizCategoria preguntas={banco.preguntas} />
    </div>
  </section>

  <section class="section" aria-labelledby="temas-moto">
    <h2 id="temas-moto">Temas del teórico de moto que practicás</h2>
    <div class="topic-chips">
      {grupos.map((grupo) => <span class="chip">{grupo.tema} ({grupo.preguntas.length})</span>)}
    </div>
  </section>

  <section id="banco-completo" class="section" aria-labelledby="banco-moto-titulo">
    <h2 id="banco-moto-titulo">{total} preguntas del test de moto con respuestas</h2>
    <p class="muted">Cada pregunta incluye la respuesta correcta, la explicación y la fuente.</p>
    {
      grupos.map((grupo) => (
        <div class="stack" style="margin-top:1.5rem;">
          <h3 style="font-size:1.15rem;">{grupo.tema}</h3>
          {grupo.preguntas.map((pregunta) => {
            questionIndex += 1;
            const index = questionIndex;
            return (
              <article class="card study-question" id={`banco-${pregunta.id}`}>
                <p class="muted study-question__kicker">
                  Pregunta {index} · {pregunta.tema}
                </p>
                <h3>{pregunta.pregunta}</h3>
                <ol class="study-options">
                  {pregunta.opciones.map((texto, optionIndex) => (
                    <li data-correct={optionIndex === pregunta.correcta ? 'true' : 'false'}>
                      {texto}
                      {optionIndex === pregunta.correcta && (
                        <span class="sr-only"> (respuesta correcta)</span>
                      )}
                    </li>
                  ))}
                </ol>
                <details>
                  <summary>Ver respuesta y explicación</summary>
                  <div class="stack" style="margin-top:0.75rem;">
                    <p>
                      <strong>Respuesta correcta:</strong> {pregunta.opciones[pregunta.correcta]}
                    </p>
                    <p>{pregunta.explicacion}</p>
                    <ul class="source-list">
                      <li>
                        <a href={pregunta.fuente.url} target="_blank" rel="noopener noreferrer">
                          {pregunta.fuente.norma}
                        </a>
                        <span class="muted"> · consultado {pregunta.verificado}</span>
                      </li>
                    </ul>
                  </div>
                </details>
              </article>
            );
          })}
        </div>
      ))
    }
  </section>

  <section class="section" aria-labelledby="subclases">
    <h2 id="subclases">Subclases de la categoría A</h2>
    <div class="subclass-wrap">
      <table class="subclass-table">
        <thead>
          <tr>
            <th scope="col">Subclase</th>
            <th scope="col">Vehículo</th>
            <th scope="col">Edad mínima</th>
          </tr>
        </thead>
        <tbody>
          {
            subclases.map(([codigo, vehiculo, edad]) => (
              <tr>
                <th scope="row">{codigo}</th>
                <td>{vehiculo}</td>
                <td>{edad}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="muted subclass-note">
      Fuente:
      <a
        href="https://www.argentina.gob.ar/seguridadvial/licencianacional/clasesysubclases"
        target="_blank"
        rel="noopener">ANSV, Clases y subclases</a
      >. La Ley 24.449 (art. 16) exige 2 años de habilitación previa para motos de más de 150 cc,
      salvo para mayores de 21.
    </p>
  </section>

  <section class="section" aria-labelledby="requisitos">
    <h2 id="requisitos">Requisitos y edades</h2>
    <div class="fact-grid">
      <article class="fact-card">
        <div class="fact-card__head">
          <span class="fact-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="5" width="16" height="15" rx="2" />
              <path d="M8 3.5v3M16 3.5v3M4 10h16" />
            </svg>
          </span>
          <h3>Edad</h3>
        </div>
        <p>
          16 años para ciclomotor sin pasajero y 17 para el resto de la clase A (Ley 24.449, art.
          11). Los menores necesitan autorización de su representante legal (art. 17).
        </p>
      </article>
      <article class="fact-card">
        <div class="fact-card__head">
          <span class="fact-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="3.2" />
              <path d="M5.5 19.2c1.4-2.6 3.7-3.9 6.5-3.9s5.1 1.3 6.5 3.9" />
            </svg>
          </span>
          <h3>Conductores principiantes</h3>
        </div>
        <p>
          Durante los primeros 6 meses, cartel identificatorio y prohibición de circular por zonas
          céntricas, autopistas y semiautopistas. Si cometés faltas graves en los primeros 2 años, la
          licencia se suspende (Decreto 779/95, art. 13 inc. d, texto del Decreto 196/2025).
        </p>
      </article>
    </div>
    <p class="muted requisitos-note">
      Los cursos, exámenes, tasas y turnos los define cada municipio. Consultá en tu Centro de
      Emisión de Licencias.
    </p>
  </section>

  <section class="section" aria-labelledby="que-se-pregunta">
    <h2 id="que-se-pregunta">Qué se pregunta en el teórico de moto</h2>
    <p>
      El teórico de moto comparte la base del examen de auto (señales, prioridades, velocidades,
      alcohol cero) y suma reglas propias de los motovehículos.
    </p>
    <div class="fact-grid">
      {
        temasMoto.map((tema) => (
          <article class="fact-card">
            <div class="fact-card__head">
              <span class="fact-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                </svg>
              </span>
              <h3>{tema.title}</h3>
            </div>
            <p>{tema.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="faq">
    <h2 id="faq">Preguntas frecuentes</h2>
    <div class="faq">
      {
        faq.map((item, index) => (
          <details open={index === 0}>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="fuentes">
    <h2 id="fuentes">Fuentes oficiales consultadas</h2>
    <ul class="source-list">
      <li>
        <a
          href="https://www.argentina.gob.ar/seguridadvial/licencianacional/clasesysubclases"
          target="_blank"
          rel="noopener">ANSV, Clases y subclases</a
        >
        <!-- TODO: fecha de consulta -->
      </li>
      <li>
        <a
          href="https://servicios.infoleg.gob.ar/infolegInternet/anexos/0-4999/818/texact.htm"
          target="_blank"
          rel="noopener">Ley 24.449 (Infoleg, texto actualizado)</a
        >
        <!-- TODO: fecha de consulta -->
      </li>
      <li>
        <a
          href="https://www.argentina.gob.ar/normativa/nacional/decreto-196-2025-410682/texto"
          target="_blank"
          rel="noopener">Decreto 196/2025</a
        >
        <!-- TODO: fecha de consulta -->
      </li>
      <li>
        <a href="/fuentes-y-metodologia/">Metodología</a>
        <!-- TODO: fecha de consulta -->
      </li>
    </ul>
  </section>

  <section class="section" aria-labelledby="otras-practicas">
    <h2 id="otras-practicas">Otras prácticas</h2>
    <ul>
      <li>
        <a href="/test-de-conducir/argentina/">Test de conducir de Argentina (auto B1)</a>
      </li>
      <li><a href="/test-de-conducir/caba/">Test de conducir CABA</a></li>
      <li><a href="/test-de-conducir/cordoba-capital/">Test de conducir Córdoba Capital</a></li>
      <li><a href="/test-de-conducir/categoria-d/">Test categoría D (pasajeros)</a></li>
      <li><a href="/test-de-conducir/categoria-e/">Test categoría E</a></li>
    </ul>
    <p class="muted">
      Práctica independiente. No es el examen oficial; el contenido y la modalidad del examen dependen
      de cada municipio.
    </p>
  </section>
</PageShell>

<style>
  .quiz-frame :global(.quiz-app) {
    max-width: none;
  }

  .quiz-frame :global(.quiz-card),
  .quiz-frame :global(.results-summary) {
    border: 0;
    box-shadow: none;
    padding: 0;
    background: transparent;
  }

  .fact-card > p {
    margin: 0;
  }

  .subclass-table {
    min-width: 36rem;
  }

  .subclass-note,
  .requisitos-note {
    margin-top: 0.85rem;
  }
</style>
