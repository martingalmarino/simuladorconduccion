---
import Layout from '../../../components/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import StudyQuestion from '../../../components/StudyQuestion.astro';
import {
  getBankForSlug,
  groupQuestionsByTopic,
  requireJurisdiction,
  sourcesForJurisdiction,
} from '../../../lib/content';
import { absoluteUrl, getSiteRuntime } from '../../../lib/site';
import { topicLabel } from '../../../lib/topics';

const slug = 'cordoba-capital';
const jurisdiction = requireJurisdiction(slug);
const bank = getBankForSlug(slug);
const groups = groupQuestionsByTopic(bank.questions);
const sources = sourcesForJurisdiction(jurisdiction.id);
const runtime = getSiteRuntime();
const pageUrl = absoluteUrl(`/test-de-conducir/${slug}/`);
let questionIndex = 0;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Practicá el test de conducir en Córdoba Capital',
    inLanguage: runtime.locale,
    description: bank.coverage,
    ...(pageUrl ? { url: pageUrl } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Inicio',
        ...(absoluteUrl('/') ? { item: absoluteUrl('/') } : {}),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Tests',
        ...(absoluteUrl('/test-de-conducir/')
          ? { item: absoluteUrl('/test-de-conducir/') }
          : {}),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Córdoba Capital',
        ...(pageUrl ? { item: pageUrl } : {}),
      },
    ],
  },
];
---

<Layout
  title="Test de conducir Córdoba Capital: práctica para autos"
  description={`Practicá el teórico de autos en Córdoba Capital con ${bank.questions.length} preguntas explicadas y con fuente. Vale para la ciudad, no para toda la provincia.`}
  pathname={`/test-de-conducir/${slug}/`}
  jsonLd={jsonLd}
>
  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Tests', href: '/test-de-conducir/' },
      { label: 'Córdoba Capital' },
    ]}
  />

  <h1>Practicá el test de conducir en Córdoba Capital</h1>
  <p class="lede">
    <strong>{bank.questions.length} preguntas</strong> para el teórico de autos (clase B1) en la
    ciudad de Córdoba. Podés estudiarlas en esta página o abrir la práctica interactiva.
  </p>

  <div class="btn-row">
    <a class="btn btn--primary" href={`/practicar/${slug}/`}>Empezar a practicar</a>
    <a class="btn btn--secondary" href="#banco-completo">Ver las {bank.questions.length} preguntas</a>
  </div>

  <section class="section notice">
    <p style="margin:0 0 0.5rem;">{bank.coverage}</p>
    <p style="margin:0;" class="muted">
      Alcance: {jurisdiction.geographicScope}. Fuentes consultadas: 2026-10-20.
    </p>
  </section>

  <section class="section" aria-labelledby="temas-cba">
    <h2 id="temas-cba">Temas incluidos</h2>
    <div class="topic-chips">
      {groups.map((g) => <span class="chip">{topicLabel(g.topic)} ({g.questions.length})</span>)}
    </div>
  </section>

  <section class="section" aria-labelledby="fuentes-cba">
    <h2 id="fuentes-cba">Fuentes útiles</h2>
    <ul class="source-list">
      {
        sources.map((source) => (
          <li>
            <a href={source.url} rel="noopener noreferrer" target="_blank">
              {source.title}
            </a>
            <span class="muted"> · consultado {source.accessedAt}</span>
            {source.usage && <span class="muted"> · {source.usage}</span>}
          </li>
        ))
      }
    </ul>
    <p class="muted">
      Detalle de metodología y límites en
      <a href="/fuentes-y-metodologia/">Fuentes y metodología</a>.
    </p>
  </section>

  <section id="banco-completo" class="section" aria-labelledby="banco-cba-titulo">
    <h2 id="banco-cba-titulo">Las {bank.questions.length} preguntas de estudio</h2>
    <p class="muted">
      Cada pregunta incluye la respuesta correcta, la explicación y la fuente. Podés enlazar una en
      particular (por ejemplo <a href="#cordoba-capital-b1-001">#cordoba-capital-b1-001</a>).
    </p>

    {
      groups.map((group) => (
        <div class="stack" style="margin-top:1.5rem;">
          <h3 style="font-size:1.15rem;">{topicLabel(group.topic)}</h3>
          {group.questions.map((question) => {
            questionIndex += 1;
            return <StudyQuestion question={question} index={questionIndex} />;
          })}
        </div>
      ))
    }
  </section>
</Layout>
