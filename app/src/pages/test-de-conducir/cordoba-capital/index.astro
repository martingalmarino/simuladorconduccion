---
import Layout from '../../../components/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FactCards from '../../../components/FactCards.astro';
import StudyQuestion from '../../../components/StudyQuestion.astro';
import {
  getBankForSlug,
  groupQuestionsByTopic,
  requireJurisdiction,
  sourcesForJurisdiction,
} from '../../../lib/content';
import { formatSourceDate, studyGraph, type FaqItem } from '../../../lib/studyGraph';
import { topicLabel } from '../../../lib/topics';
import RoadSigns from '../../../components/ui/RoadSigns.astro';
import IndependenceNote from '../../../components/IndependenceNote.astro';

const slug = 'cordoba-capital';
const jurisdiction = requireJurisdiction(slug);
const bank = getBankForSlug(slug);
const groups = groupQuestionsByTopic(bank.questions);
const sources = sourcesForJurisdiction(jurisdiction.id);
const updated = sources.map((source) => source.accessedAt).sort().at(-1) ?? '2026-10-20';
let questionIndex = 0;

const title = 'Test de conducir Córdoba 2026: preguntero y simulador';
const description =
  'Practicá el examen teórico de conducir de la ciudad de Córdoba: 50 preguntas para auto (B1) según la Ordenanza 9981, con respuesta explicada. Gratis.';

const faq: FaqItem[] = [
  {
    question: '¿Qué tengo que estudiar para el examen teórico en Córdoba Capital?',
    answer:
      'La Guía de Estudio de la Municipalidad de Córdoba y el Código de Tránsito municipal (Ordenanza 9981). La guía está en cordoba.gob.ar/milicencia.',
  },
  {
    question: '¿El teórico y el práctico se rinden el mismo día en Córdoba?',
    answer:
      'Según el procedimiento municipal, el día del turno se hace la revisión médica, luego el examen teórico y, si lo aprobás, el práctico.',
  },
  {
    question: '¿Necesito hacer un curso para sacar la licencia de auto en Córdoba?',
    answer:
      'Según la Municipalidad, el Curso de Seguridad Vial es requisito para la primera licencia de moto y para licencias profesionales. Consultá la Guía de Trámites para tu caso.',
  },
  {
    question: '¿Desde qué edad puedo sacar la licencia de auto en Córdoba?',
    answer:
      'La clase B1 se puede pedir desde los 17 años. Si sos menor de 18, necesitás examen de aptitud psicológica y autorización de padre, madre o tutor.',
  },
  {
    question: '¿Este preguntero sirve para toda la provincia de Córdoba?',
    answer:
      'No. Está basado en la normativa de la ciudad de Córdoba. En otras localidades, consultá a tu municipio y practicá también con el test nacional.',
  },
  {
    question: '¿Es el examen oficial de la Municipalidad?',
    answer: 'No. Es una práctica independiente basada en fuentes oficiales.',
  },
];

const extraSources = [
  {
    title: 'Municipalidad de Córdoba — Mi Licencia',
    url: 'https://cordoba.gob.ar/milicencia/',
  },
  {
    title: 'Guía de Trámites — Licencia por primera vez',
    url: 'https://guiadetramites.cordoba.gob.ar/#/ciudadano/tramite/299',
  },
];

const jsonLd = studyGraph({
  pathname: `/test-de-conducir/${slug}/`,
  title,
  description,
  dateModified: updated,
  quizName: '50 preguntas del examen de manejo de Córdoba Capital (clase B1)',
  legislationName: 'Ordenanza 9981 — Código de Tránsito de la Ciudad de Córdoba',
  coverageType: 'City',
  coverageName: 'Ciudad de Córdoba',
  quizAbout: 'Normas de tránsito de la ciudad de Córdoba',
  citations: [...sources.map((source) => source.url), ...extraSources.map((source) => source.url)],
  breadcrumbName: 'Córdoba Capital',
  faq,
});
---

<Layout
  title={title}
  description={description}
  pathname={`/test-de-conducir/${slug}/`}
  exactTitle={true}
  jsonLd={jsonLd}
>
  <div class="guide-hero">
    <div>
  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Tests', href: '/test-de-conducir/' },
      { label: 'Córdoba Capital' },
    ]}
  />

  <h1>Test de conducir Córdoba Capital: preguntero del examen teórico</h1>
  <IndependenceNote />
  <p class="lede">
    Prepará el examen teórico de manejo de la Municipalidad de Córdoba con 50 preguntas para autos
    (clase B1). Están basadas en el Código de Tránsito municipal (Ordenanza 9981) y en la Guía de
    Estudio oficial. Cada respuesta incluye explicación y fuente. Vale para la ciudad de Córdoba, no
    para otras localidades de la provincia, y no es un examen oficial.
  </p>
  <p class="muted">
    Actualizado: <time datetime={updated}>{formatSourceDate(updated)}</time>
  </p>

  <div class="btn-row">
    <a class="btn btn--primary" href={`/practicar/${slug}/`}>Empezar a practicar</a>
    <a class="btn btn--secondary" href="#banco-completo">Ver las {bank.questions.length} preguntas</a>
  </div>
    </div>
    <RoadSigns />
  </div>

  <section class="section" aria-labelledby="respuesta-rapida">
    <h2 id="respuesta-rapida">¿Cómo es el examen de conducir en Córdoba Capital?</h2>
    <FactCards
      cards={[
        {
          title: 'El día del turno',
          icon: 'calendar',
          items: ['Revisión médica', 'Examen teórico', 'Si lo aprobás, el práctico'],
          note: 'En el Centro de Emisión de Licencias, según la Ordenanza 9981.',
        },
        {
          title: 'Para estudiar',
          icon: 'book',
          items: ['Guía de Estudio de la Municipalidad'],
          note: 'La recomienda la Municipalidad y está en cordoba.gob.ar/milicencia.',
        },
      ]}
    />
  </section>

  <section class="section" aria-labelledby="como-es-el-examen">
    <h2 id="como-es-el-examen">Cómo sacar la licencia de conducir en Córdoba por primera vez</h2>
    <FactCards
      cards={[
        {
          title: 'Requisitos para B1',
          icon: 'user',
          items: [
            'DNI con domicilio actualizado en la ciudad de Córdoba',
            'Declaración jurada de salud',
            'Boleta de pago CENAT',
            'Edad mínima: 17 años',
            'Vehículo acorde a la clase para el práctico',
          ],
          note: 'Si tenés menos de 18 años, sumá examen de aptitud psicológica y autorización de padre, madre o tutor.',
        },
        {
          title: 'Paso a paso',
          icon: 'list',
          items: [
            'Sacá turno en el Turnero Digital de Vecino Digital (VeDi) o por teléfono',
            'Presentate con la documentación',
            'Hacé la revisión médica',
            'Rendí el examen teórico',
            'Rendí el examen práctico',
            'Pagá la tasa municipal y se emite la licencia',
          ],
          note: 'Verificá los requisitos vigentes en la Guía de Trámites de la Municipalidad.',
        },
        {
          title: 'Qué cubre la guía',
          icon: 'book',
          items: [
            'Señales, prioridades y velocidades',
            'Circulación y alcoholemia',
            'Actuación ante siniestros',
          ],
        },
        {
          title: 'Curso de seguridad vial',
          icon: 'list',
          items: [
            'Obligatorio para la primera licencia de moto',
            'Obligatorio para licencias profesionales',
          ],
        },
      ]}
    />
  </section>

  <section class="section" aria-labelledby="temas-cba">
    <h2 id="temas-cba">Temas del examen teórico de Córdoba que practicás</h2>
    <div class="topic-chips">
      {groups.map((g) => <span class="chip">{topicLabel(g.topic)} ({g.questions.length})</span>)}
    </div>
  </section>

  <section id="banco-completo" class="section" aria-labelledby="banco-cba-titulo">
    <h2 id="banco-cba-titulo">50 preguntas del examen de manejo de Córdoba con respuestas</h2>
    <p class="muted">
      Cada pregunta incluye la respuesta correcta, la explicación y la fuente.
    </p>
    {
      groups.map((group) => (
        <div class="stack" style="margin-top:1.5rem;">
          <h3 style="font-size:1.15rem;">{topicLabel(group.topic)}</h3>
          {group.questions.map((question) => {
            questionIndex += 1;
            return <StudyQuestion question={question} index={questionIndex} />;
          })}
        </div>
      ))
    }
  </section>

  <section class="section" aria-labelledby="faq">
    <h2 id="faq">Preguntas frecuentes sobre el examen de conducir en Córdoba</h2>
    <div class="faq">
      {
        faq.map((item, index) => (
          <details open={index === 0}>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="fuentes-cba">
    <h2 id="fuentes-cba">Fuentes oficiales consultadas</h2>
    <ul class="source-list">
      {
        sources.map((source) => (
          <li>
            <a href={source.url} rel="noopener noreferrer" target="_blank">
              {source.title}
            </a>
            <span class="muted"> · consultado {source.accessedAt}</span>
            {source.usage && <span class="muted"> · {source.usage}</span>}
          </li>
        ))
      }
      {
        extraSources.map((source) => (
          <li>
            <a href={source.url} rel="noopener noreferrer" target="_blank">
              {source.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="otras-practicas">
    <h2 id="otras-practicas">Otras prácticas</h2>
    <ul>
      <li>
        <a href="/test-de-conducir/argentina/">Test de conducir Argentina (normativa nacional)</a>
      </li>
      <li><a href="/test-de-conducir/caba/">Test de conducir CABA</a></li>
      <li><a href="/practicar/cordoba-capital/">Práctica interactiva de Córdoba</a></li>
      <li><a href="/fuentes-y-metodologia/">Fuentes y metodología</a></li>
    </ul>
  </section>
</Layout>
