---
import Layout from '../../components/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JurisdictionCard from '../../components/JurisdictionCard.astro';
import UpcomingTestCard from '../../components/UpcomingTestCard.astro';
import CategoriaACard from '../../components/CategoriaACard.astro';
import RoadSigns from '../../components/ui/RoadSigns.astro';
import bancoCategoriaA from '../../data/preguntas-categoria-a.json';
import { getBank, getSiteConfig, getUpcomingTests } from '../../lib/content';
import { absoluteUrl, getSiteRuntime } from '../../lib/site';

const config = getSiteConfig();
const runtime = getSiteRuntime();
const cards = config.jurisdictions.map((j) => ({
  jurisdiction: j,
  bank: getBank(j.bankId),
}));
const upcomingTests = getUpcomingTests();
const pageUrl = absoluteUrl('/test-de-conducir/');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Elegí dónde vas a rendir',
    inLanguage: runtime.locale,
    description:
      'Directorio de práctica: marco nacional, CABA, Córdoba Capital y motos (categoría A).',
    ...(pageUrl ? { url: pageUrl } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Inicio',
        ...(absoluteUrl('/') ? { item: absoluteUrl('/') } : {}),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Tests de conducir',
        ...(pageUrl ? { item: pageUrl } : {}),
      },
    ],
  },
];
---

<Layout
  title="Tests de conducir por jurisdicción: elegí dónde practicar"
  description="Elegí práctica general, el banco de tu ciudad o el test de motos (categoría A). Preguntas con explicación y fuente."
  pathname="/test-de-conducir/"
  jsonLd={jsonLd}
>
  <div class="guide-hero">
    <div>
      <Breadcrumbs
        items={[
          { label: 'Inicio', href: '/' },
          { label: 'Tests de conducir' },
        ]}
      />

      <p class="kicker">Directorio de práctica</p>
      <h1>Elegí dónde vas a rendir</h1>
      <p class="lede">
        Hay un banco de práctica general sobre el marco nacional y bancos locales para CABA y Córdoba
        Capital. No mezclamos normas entre ellos. También está el test de motos (categoría A).
      </p>
    </div>
    <RoadSigns />
  </div>

  <div class="card-grid">
    {
      cards.map(({ jurisdiction, bank }) => (
        <JurisdictionCard jurisdiction={jurisdiction} bank={bank} />
      ))
    }
    <CategoriaACard questionCount={bancoCategoriaA.preguntas.length} />
  </div>

  <section class="section" aria-labelledby="proximamente-directorio">
    <h2 id="proximamente-directorio">Próximamente</h2>
    <p class="lede">
      Categorías anunciadas. Todavía no hay preguntas para practicarlas.
    </p>
    <div class="card-grid">
      {upcomingTests.map((test) => <UpcomingTestCard test={test} />)}
    </div>
  </section>

  <section class="section notice callout">
    <p style="margin:0;">
      Este sitio no ofrece un simulacro oficial con tiempo ni nota de aprobación. Es práctica para
      repasar el teórico.
    </p>
  </section>
</Layout>
